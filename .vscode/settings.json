{
  "mdx.validate": false,
  "mdx.server.enable": false,
  "[mdx]": {
    "editor.defaultFormatter": "vscode.typescript-language-features",
    "editor.formatOnSave": false
  },
  "files.associations": {
    "*.mdx": "mdx"
  },
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact",
    "astro"
  ],
  "workbench.colorCustomizations": {
    "activityBar.activeBackground": "#0000ff",
    "activityBar.background": "#0000ff",
    "activityBar.foreground": "#e7e7e7",
    "activityBar.inactiveForeground": "#e7e7e799",
    "activityBarBadge.background": "#400000",
    "activityBarBadge.foreground": "#e7e7e7",
    "commandCenter.border": "#e7e7e799",
    "sash.hoverBorder": "#0000ff",
    "statusBar.background": "#0000cc",
    "statusBar.foreground": "#e7e7e7",
    "statusBarItem.hoverBackground": "#0000ff",
    "statusBarItem.remoteBackground": "#df0000",
    "statusBarItem.remoteForeground": "#e7e7e7",
    "titleBar.activeBackground": "#0000cc",
    "titleBar.activeForeground": "#e7e7e7",
    "titleBar.inactiveBackground": "#0000cc99",
    "titleBar.inactiveForeground": "#e7e7e799",
    "activityBarTop.activeBackground": "#0000ff",
    "activityBarTop.background": "#0000ff",
    "activityBarTop.foreground": "#e7e7e7",
    "activityBarTop.inactiveForeground": "#e7e7e799",
    "commandCenter.foreground": "#e7e7e7",
    "statusBar.debuggingBackground": "#0000cc",
    "statusBar.debuggingForeground": "#e7e7e7"
  },
  "peacock.color": "#0000cc"
} 