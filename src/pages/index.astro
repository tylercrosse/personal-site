---
import { getCollection, type CollectionEntry } from "astro:content";
import readingTime from "reading-time";
import { ExternalLink, FileText, Youtube } from "lucide-astro";

import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import PondHero from "../components/PondHero.astro";
import SocialLinks from "../components/SocialLinks.astro";
import { getResearchProjects, getTalks } from "../utils/research";
import socialCards from "../config/socialCards.json";

const slugOf = (id: string) => id.replace(/(\/index)?\.(md|mdx)$/, "");

const posts = (await getCollection("ideas"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => {
    const aDate = a.data.pubDate || a.data.date;
    const bDate = b.data.pubDate || b.data.date;
    return new Date(bDate || 0).valueOf() - new Date(aDate || 0).valueOf();
  });

function toCardData(post: CollectionEntry<"ideas">) {
  return {
    id: post.id,
    slug: slugOf(post.id),
    title: post.data.title,
    description: post.data.description,
    date: post.data.pubDate || post.data.date,
    type: post.data.type,
    status: post.data.status,
    tags: post.data.tags || [],
    image: post.data.image,
    draft: post.data.draft,
    research: post.data.research,
    readingTimeText: readingTime(post.body || "").text,
  };
}

const allPostsData = posts.map(toCardData);

function getPost(slug: string) {
  const post = allPostsData.find((candidate) => candidate.slug === slug);
  if (!post) throw new Error(`Missing homepage selection: ${slug}`);
  return post;
}

// Selected research: hand-picked, with shorter display titles than the paper titles.
const lead = getPost("2026/paper-attack-selection");
const goalDrift = getPost("2026/paper-asymmetric-goal-drift");
const interpretability = getPost("2026/llm-morality-mech-interp");

const paperLinks = (post: typeof lead) =>
  (post.research?.links ?? []).filter((link) => link.label !== "Write-up");

const showcase = {
  post: {
    ...lead,
    title: "Attack selection in AI control",
    description: "Control evaluations can overestimate safety when attackers choose when to act.",
  },
  meta: ["NeurIPS 2026", "Co-first author"],
  highlight: "<strong>20–28 percentage-point drop</strong> in measured safety at a 1% audit budget across two environments.",
  links: paperLinks(lead),
};

const rail = [
  {
    post: {
      ...goalDrift,
      title: "Goal drift under value conflict",
      description: "Coding agents break explicit constraints more readily when those constraints oppose trained-in values.",
    },
    meta: ["ICLR 2026 workshops", "AI-WILD spotlight"],
    links: paperLinks(goalDrift),
  },
  {
    post: {
      ...interpretability,
      title: "Moral fine-tuning, under the hood",
      description: "Investigating how moral fine-tuning changes attention pathways.",
    },
    meta: ["ARENA project", "Draft"],
    links: [{ label: "Code", href: "https://github.com/tylercrosse/LLM_morality" }],
  },
];

// Recent Work: the remaining papers plus talks.
const research = await getResearchProjects();
const highlightedSlugs = new Set([lead.slug, goalDrift.slug]);

type WorkItem = {
  title: string;
  href: string;
  meta: string;
  source?: { label: string; href: string };
};

const otherPapers: WorkItem[] = research
  .filter((post) => !highlightedSlugs.has(slugOf(post.id)))
  .map((post) => {
    const paper = post.data.research!.links.find((link) => link.label === "Paper");
    return {
      title: post.data.title,
      href: post.href,
      meta: `${post.data.research!.venue} · ${post.data.research!.role}`,
      source: paper && { label: "Paper", href: paper.href },
    };
  });

const talks: WorkItem[] = (await getTalks()).map(({ title, href, context }) => ({
  title,
  href,
  meta: context,
}));

const recentWorkGroups = [
  { heading: "More papers", icon: FileText, items: otherPapers },
  { heading: "Talks & presentations", icon: Youtube, items: talks },
];

// Selected Posts: recent writing with one post per primary tag first, for breadth.
// Papers already appear above, so keep them out.
const shownSlugs = new Set([lead.slug, goalDrift.slug, interpretability.slug]);
const recentCandidates = allPostsData.filter(
  (p) => !shownSlugs.has(p.slug) && p.type !== "paper",
);
const notebookTargetCount = 8;

const diverseNotebook = recentCandidates.reduce<typeof allPostsData>((selected, post) => {
  const primaryTag = post.tags[0];
  if (!primaryTag) return selected;
  if (selected.some((candidate) => candidate.tags[0] === primaryTag)) {
    return selected;
  }
  return [...selected, post];
}, []);

const notebook = [
  ...diverseNotebook,
  ...recentCandidates.filter(
    (post) => !diverseNotebook.some((candidate) => candidate.id === post.id),
  ),
].slice(0, notebookTargetCount);
---

<BaseLayout
  title="Home"
  description={socialCards.home.description}
  image={socialCards.home.image}
  imageAlt={socialCards.home.alt}
>
  <PondHero>
    <div class="profile slide-in-block">
      <h1 class="profile-name">Tyler Crosse</h1>
      <p class="profile-role">Research Scientist at AE Studio</p>
      <p class="profile-bio">
        I study when models depart from human intent, and how to evaluate and
        oversee their behavior.
      </p>
      <SocialLinks showRss={false} />
    </div>
  </PondHero>

  <section class="showcase slide-in-block" aria-label="Selected research">
    <div class="showcase-hero">
      <PostCard
        post={showcase.post}
        variant="showcase"
        meta={showcase.meta}
        highlight={showcase.highlight}
        links={showcase.links}
        eager
      />
    </div>
    <div class="showcase-rail">
      {rail.map((item) => (
        <PostCard post={item.post} variant="compact" meta={item.meta} links={item.links} />
      ))}
    </div>
  </section>

  <section class="recent-work slide-in-block" aria-labelledby="recent-work-title">
    <header class="section-header">
      <h2 id="recent-work-title">Recent Work</h2>
      <a href="/research" class="section-all">all research →</a>
    </header>
    <div class="recent-work-grid">
      {recentWorkGroups.map((group) => {
        const GroupIcon = group.icon;
        return (
          <section class="work-group" aria-label={group.heading}>
            <h3 class="work-group-title">
              <GroupIcon class="work-group-icon" size={14} aria-hidden="true" />
              <span>{group.heading}</span>
            </h3>
            <ul class="work-list">
              {group.items.map((item) => (
                <li class="work-item">
                  <a href={item.href} class="work-link">
                    <span class="work-title">{item.title}</span>
                  </a>
                  <p class="work-meta">
                    {item.meta}
                    {item.source && (
                      <>
                        {" · "}
                        <a
                          class="work-source-link"
                          href={item.source.href}
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          {item.source.label}
                          <ExternalLink class="work-link-icon" size={11} aria-hidden="true" />
                          <span class="sr-only">opens in a new tab</span>
                        </a>
                      </>
                    )}
                  </p>
                </li>
              ))}
            </ul>
          </section>
        );
      })}
    </div>
  </section>

  <section class="notebook slide-in-block" aria-labelledby="notebook-title">
    <header class="section-header">
      <h2 id="notebook-title">Selected Posts</h2>
      <a href="/ideas" class="section-all">all writing →</a>
    </header>
    <div class="notebook-grid">
      {notebook.map((post) => (
        <PostCard post={post} variant="mini" />
      ))}
    </div>
  </section>
</BaseLayout>
<style>
  :global(main) {
    padding: 2rem 1.5rem 4rem;
  }

  @media (min-width: 768px) {
    :global(main) {
      padding: 3rem 2rem 5rem;
    }
  }

  /* Profile intro, set over the pond hero */
  .profile {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    max-width: 40rem;
    margin: 0 auto;
    text-shadow: 0 1px 18px rgba(4, 30, 12, 0.55);
  }

  .profile-name {
    font-family: var(--font-heading);
    font-size: clamp(3rem, 9vw, 6.5rem);
    line-height: 0.95;
    letter-spacing: -0.03em;
    margin: 0;
    font-weight: 700;
    color: #fff;
    text-shadow: 0 2px 48px rgba(4, 30, 12, 0.45);
  }

  .profile-role {
    margin: 0 0 -0.5rem;
    color: #fff;
    font-size: clamp(1.1rem, 1.6vw, 1.35rem);
    line-height: 1.4;
  }

  .profile-bio {
    margin: 0;
    color: rgba(255, 255, 255, 0.92);
    font-size: clamp(1.02rem, 1.25vw, 1.2rem);
    line-height: 1.55;
    max-width: 34rem;
  }

  .profile :global(.social-links a) {
    color: #fff;
    filter: drop-shadow(0 1px 6px rgba(4, 30, 12, 0.6));
  }

  .profile :global(.social-links a:hover) {
    color: #e7f6f2;
  }

  /* Recent work */
  .recent-work {
    max-width: 1200px;
    margin: 0 auto 3rem;
    padding-inline: 0;
    box-sizing: border-box;
  }

  .section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .section-header h2 {
    font-family: var(--font-heading);
    font-size: 1.35rem;
    font-weight: 700;
    margin: 0;
  }

  .section-all {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--sol-8);
    text-decoration: none;
    letter-spacing: 0.02em;
  }

  .section-all:hover {
    color: var(--sol-9);
  }

  .section-all:focus-visible {
    outline: 2px solid var(--blue);
    outline-offset: 3px;
    border-radius: 2px;
  }

  .recent-work-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem;
  }

  @media (min-width: 900px) {
    .recent-work-grid {
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.9fr);
      gap: 2.5rem;
    }
  }

  @media (min-width: 1100px) {
    .recent-work {
      padding-inline: 5rem;
    }
  }

  .work-group {
    min-width: 0;
  }

  .work-group-title {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--sol-7);
  }

  .work-group-icon {
    flex-shrink: 0;
    opacity: 0.85;
    vertical-align: middle;
  }

  .work-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--main-border-color);
  }

  .work-item {
    padding: 0.95rem 0;
    border-bottom: 1px solid var(--main-border-color);
    line-height: 1.35;
  }

  .work-link {
    color: var(--sol-10);
    text-decoration: none;
    line-height: 1.35;
  }

  .work-link:hover {
    color: var(--sol-9);
  }

  .work-link:focus-visible {
    outline: 2px solid var(--blue);
    outline-offset: 3px;
    border-radius: 2px;
  }

  .work-title {
    font-family: var(--font-heading);
    font-size: 1.02rem;
    font-weight: 600;
    line-height: 1.35;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.14em;
    transition:
      color 0.2s ease,
      text-decoration-color 0.2s ease;
  }

  .work-link-icon {
    display: inline;
    opacity: 0.72;
  }

  .work-meta {
    margin: 0.5rem 0 0;
    color: var(--sol-8);
    font-size: 0.88rem;
    line-height: 1.1;
    transition: color 0.2s ease;
  }

  .work-source-link {
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.14em;
    white-space: nowrap;
    transition: color 0.2s ease;
  }

  .work-source-link:hover,
  .work-source-link:focus-visible {
    color: var(--sol-9);
  }

  .work-link:hover .work-title,
  .work-link:focus-visible .work-title {
    text-decoration-color: currentColor;
  }

  .work-link:hover + .work-meta,
  .work-link:focus-visible + .work-meta {
    color: var(--sol-9);
  }

  :global([data-effective-theme="dark"]) .work-list,
  :global([data-effective-theme="dark"]) .work-item {
    border-color: var(--base03);
  }

  :global([data-effective-theme="dark"]) .work-link {
    color: var(--sol-5);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Showcase */
  .showcase {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    max-width: 1200px;
    margin: 0 auto 3rem;
  }

  @media (min-width: 900px) {
    .showcase {
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
      gap: 1.75rem;
      /* align-items: start; */
    }
  }

  .showcase-rail {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 600px) and (max-width: 899px) {
    .showcase-rail {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Notebook */
  .notebook {
    max-width: 1200px;
    margin: 0 auto;
  }

  .notebook-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 600px) {
    .notebook-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .notebook-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (min-width: 1100px) {
    .notebook .section-header {
      padding-inline: 5rem;
    }
  }

  /* Entrance animations */
  .slide-in-block {
    opacity: 0;
    filter: blur(8px);
    transform: scale(0.98);
    will-change: transform, opacity, filter;
    animation: slideInBlock 0.45s cubic-bezier(0.43, 0.195, 0.02, 1) forwards;
  }

  .profile.slide-in-block {
    animation-delay: 0.05s;
  }
  .recent-work.slide-in-block {
    animation-delay: 0.2s;
  }
  .showcase.slide-in-block {
    animation-delay: 0.25s;
  }
  .notebook.slide-in-block {
    animation-delay: 0.35s;
  }

  @media (prefers-reduced-motion: reduce) {
    .slide-in-block {
      opacity: 1;
      filter: none;
      transform: none;
      animation: none;
    }
  }

  @keyframes slideInBlock {
    to {
      opacity: 1;
      filter: blur(0);
      transform: scale(1);
    }
  }
</style>
