---
import { type CollectionEntry, getCollection } from "astro:content";
import BlogPost from "../../layouts/BlogPost.astro";
import { render } from "astro:content";
import type { MarkdownHeading } from "astro";
import readingTime from "reading-time";
import { getSeriesInfo, type SeriesInfo } from "../../utils/series";
import { legacyFooterAttribution } from "../../utils/referenceFooter";

export async function getStaticPaths() {
  const posts = (await getCollection("ideas")).filter((post) => {
    // In development, show all posts including drafts
    // In production, only show published posts (not drafts)
    return import.meta.env.DEV || !post.data.draft;
  });

  // Series (parent/child) navigation, computed over the same visible set so
  // prev/next links never point at an unpublished post.
  const seriesInfo = getSeriesInfo(posts);

  const headings = await Promise.all(
    posts.map(async (post) => {
      const data = await render(post);
      return data.headings;
    })
  );

  return posts.map((post, index) => {
    const stats = readingTime(post.body || "");
    return {
      params: { slug: post.id },
      props: {
        post,
        headings: headings[index],
        readingTimeText: stats.text,
        series: seriesInfo.get(post.id) ?? null,
      },
    };
  });
}

type Props = {
  post: CollectionEntry<"ideas">;
  headings: MarkdownHeading[];
  readingTimeText: string;
  series: SeriesInfo | null;
};

const { post, headings, readingTimeText, series } = Astro.props;
const { Content } = await render(post);

// Bib-key `sources`/`credits` render inside the article's References section
// (rehypeArticleCitations); the footer only receives the legacy self-contained
// entries so nothing is listed twice. Overrides the raw frontmatter spread
// below.
const referenceFooter = legacyFooterAttribution(post);
---

<BlogPost
  {...post.data}
  sources={referenceFooter.sources}
  credits={referenceFooter.credits}
  headings={headings}
  readingTimeText={readingTimeText}
  series={series}
>
  <Content />
</BlogPost>
