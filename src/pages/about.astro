---
import { Image } from "astro:assets";
import { Briefcase, GraduationCap } from "lucide-astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import SocialLinks from "../components/SocialLinks.astro";
import socialCards from "../config/socialCards.json";

const experience = [
  {
    org: "Knowable",
    role: "Senior Software Engineer & Team Lead",
    dates: "Jun 2019 - Jun 2024",
    summary:
      "Led a five-engineer team building a legal knowledge platform. I took LLM and search prototypes into production over several million contracts and built distributed services and developer tooling.",
  },
  {
    org: "Rosetta Stone",
    role: "Software Engineer",
    dates: "Aug 2017 - Jun 2019",
    summary:
      "Rebuilt a React and Node marketing platform with page loads about 2.25 times faster, built an internal A/B testing system, and maintained services for a platform serving millions of learners.",
  },
];

const education = [
  {
    org: "Georgia Institute of Technology",
    role: "MS Computer Science",
    dates: "May 2026",
    summary: "Focused on machine learning and computing systems.",
  },
  {
    org: "Virginia Commonwealth University",
    role: "BS Biomedical Engineering",
    dates: "Dec 2023",
    summary: "Engineering, physiology, and the design of systems for medical and biological problems.",
  },
];

const background = [
  { label: "Experience", icon: Briefcase, entries: experience },
  { label: "Education", icon: GraduationCap, entries: education },
];

const interests = [
  {
    emoji: "🧩",
    title: "Mechanistic interpretability",
    text: "Sparse autoencoders, circuits, and tools to open up black boxes so we can understand and steer models.",
  },
  {
    emoji: "🎯",
    title: "AI safety & alignment",
    text: "Keeping capable agents within the intent and limits people set for them, and checking that our safeguards hold.",
  },
  {
    emoji: "🛡️",
    title: "Robustness & evaluation",
    text: "Empirical evaluation under distribution shift; honesty/helpfulness metrics; reproducibility and measurement.",
  },
  {
    emoji: "🔧",
    title: "Systems for ML",
    text: "Operating systems, distributed systems, and tooling that make ML research reliable, scalable, and repeatable.",
  },
  {
    emoji: "⚡",
    title: "High-performance computing",
    text: "GPU programming, parallelism, computer architecture, and the memory systems underneath modern models.",
  },
  {
    emoji: "📚",
    title: "Learning in public",
    text: "Sharing the journey—methods, failures, and breakthroughs—so others can learn alongside me.",
  },
  {
    emoji: "⚖️",
    title: "Economics",
    text: "Understanding the economic forces that shape our world.",
  },
  {
    emoji: "🧬",
    title: "Computational biology",
    text: "Understanding the biological mechanisms that underlie disease and development.",
  },
];
---

<BaseLayout
  title="About"
  description={socialCards.about.description}
  image={socialCards.about.image}
  imageAlt={socialCards.about.alt}
>
  <div class="about">
    <header class="intro">
      <div class="intro-copy">
        <h1>Hi, I'm Tyler</h1>
        <p class="lede">
          I study how AI models perceive the world and the situations they're
          in, and when that perception leads them to cause harm.
        </p>
        <SocialLinks showRss={false} />
      </div>
      <Image class="headshot" src="/img/headshot.jpeg" alt="Tyler Crosse" width={180} height={180} />
    </header>

    <section aria-labelledby="current">
      <h2 id="current">What I work on</h2>
      <p>
        I'm a Research Scientist at AE Studio, where I study when models
        misunderstand, overlook, or override what users intend. We look at
        this from the inside, through how models represent intent internally,
        and from the outside, through how agents actually behave.
      </p>
      <p>
        Every model acts on its own picture of what's going on. That includes
        what it's been asked to do, who it's working for, and whether anyone is
        watching. When that picture is wrong, or right in ways we didn't plan
        for, agents can take harmful actions. My work tries to find those
        situations and figure out how to prevent them.
      </p>
      <p>
        As models get better at reading their circumstances, I'm especially
        interested in whether they can tell when they're being tested or
        monitored, and whether our safeguards still hold when they can.
      </p>
    </section>

    <section aria-labelledby="recent">
      <h2 id="recent">Recent research</h2>
      <ul class="research-list">
        <li>
          <strong>AI control with Redwood Research.</strong> I studied how an
          attacking agent's choice of when to start or abandon an attack changes
          the apparent safety of control protocols. Selective attack policies
          reduced measured safety by 20-28 percentage points at a 1% audit budget
          across BashArena and LinuxArena, so control evaluations that use naive
          attackers can overstate how safe a protocol is. I co-developed the
          methodology, built evaluation infrastructure, and designed and ran
          most experiments. Our
          <a href="/ideas/2026/paper-attack-selection/">co-first-author paper</a>
          was accepted at NeurIPS 2026 and at three ICML 2026 workshops. The
          project began through MARS 4.0 and continued on contract at Redwood.
        </li>
        <li>
          <strong>Agent evaluation with SPAR.</strong> I built a harness for
          measuring constraint violations in long-horizon coding tasks and
          co-developed and ran experiments on
          <a href="/ideas/2026/paper-asymmetric-goal-drift/">goal drift in coding agents</a>
          and <a href="/ideas/2026/paper-inherited-goal-drift/">the effects of inherited context</a>.
          Agents broke system-prompt constraints more readily when those
          constraints conflicted with values from their training, and agents
          that resisted direct pressure still drifted after inheriting flawed
          trajectories from weaker models. In Spring 2026, I contributed to the
          backend for a participant study on human-AI oversight.
        </li>
        <li>
          <strong>Interpretability at ARENA 7.0.</strong> In London, I
          fine-tuned Gemma-2-2b with PPO and LoRA on an iterated prisoner's
          dilemma, then used activation patching, path patching, and steering
          vectors to study
          <a href="/ideas/2026/llm-morality-mech-interp/">how moral fine-tuning changes the model</a>.
          It reroutes attention pathways and leaves the selfish behavior in
          place, which suggests safety from fine-tuning can be shallower than
          it looks.
        </li>
      </ul>
      <a class="quiet-link" href="/research">research summaries, papers, and code →</a>
    </section>

    <section aria-labelledby="background">
      <h2 id="background">My background</h2>
      <p>
        My undergraduate degree is in biomedical engineering. I ended up in
        software, where I spent seven years working on consumer products,
        enterprise search, and distributed services. Seeing the early results
        from AlphaFold pushed me to study machine learning more seriously, and
        I returned to school for Georgia Tech's MSCS. The engineering is still
        a large part of how I do research. I build the harnesses and pipelines
        my experiments run on, and I do most of that work with coding agents.
      </p>

      {background.map((group) => {
        const GroupIcon = group.icon;
        return (
          <div class="entry-group">
            <h3 class="group-label">
              <GroupIcon size={14} aria-hidden="true" />
              <span>{group.label}</span>
            </h3>
            <ul class="entries">
              {group.entries.map((entry) => (
                <li class="entry">
                  <h4>{entry.org}</h4>
                  <p class="entry-meta">
                    <span class="entry-role">{entry.role}</span>
                    <span>{entry.dates}</span>
                  </p>
                  <p class="entry-summary">{entry.summary}</p>
                </li>
              ))}
            </ul>
          </div>
        );
      })}
    </section>

    <section aria-labelledby="interests">
      <h2 id="interests">What I'm interested in</h2>
      <ul class="interests">
        {interests.map((interest) => (
          <li class="interest">
            <h3><span class="interest-emoji" aria-hidden="true">{interest.emoji}</span>{interest.title}</h3>
            <p>{interest.text}</p>
          </li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="garden">
      <h2 id="garden">About this digital garden</h2>
      <p>
        This site also holds technical write-ups, research notes, course
        retrospectives, and project logs. Some are finished articles; others
        change as my understanding does. I try to include the method, mistakes,
        and intermediate reasoning.
      </p>
      <p>
        Browse the <a href="/ideas">writing archive</a>, or
        <a href="mailto:tylerscottcrosse@gmail.com">send me a note</a> if you
        notice an error or want to discuss something.
      </p>
      <p class="note">
        Built with <a href="https://astro.build/">Astro</a>.
        <a href="https://github.com/tylercrosse/personal-site">Source code</a>.
      </p>
    </section>
  </div>
</BaseLayout>

<style>
  :global(main) {
    padding: 0;
  }

  /* 800px matches the blog-post prose column. */
  .about {
    max-width: 800px;
    margin: 0 auto;
    padding: 3rem 1.5rem 5rem;
  }

  .intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 180px;
    gap: 2rem;
    align-items: start;
  }

  .intro-copy {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.5rem, 6vw, 4rem);
    line-height: 1.05;
  }

  .lede {
    margin: 0;
    color: var(--sol-8);
    font-size: clamp(1.1rem, 1.4vw, 1.25rem);
    line-height: 1.55;
  }

  .intro :global(.social-links) {
    margin-left: -0.5rem;
  }

  .intro :global(.headshot) {
    width: 180px;
    height: 180px;
    object-fit: cover;
    border-radius: 4px;
  }

  section {
    margin-top: 3.5rem;
  }

  h2 {
    margin: 0 0 1rem;
    font-size: 1.8rem;
  }

  p,
  li {
    line-height: 1.7;
  }

  section > p {
    margin: 0 0 1rem;
  }

  /* Recent research: bold lead-ins make each project scannable. */
  .research-list {
    margin: 0 0 0.5rem;
    padding-left: 1.2rem;
  }

  .research-list li + li {
    margin-top: 0.85rem;
  }

  .research-list strong {
    color: var(--sol-10);
  }

  :global([data-effective-theme="dark"]) .research-list strong {
    color: var(--sol-5);
  }

  .quiet-link {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.02em;
    color: var(--sol-8);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
    transition: color 0.2s ease, text-decoration-color 0.2s ease;
  }

  .quiet-link:hover,
  .quiet-link:focus-visible {
    color: var(--sol-10);
    text-decoration-color: currentColor;
  }

  :global([data-effective-theme="dark"]) .quiet-link:hover {
    color: var(--sol-5);
  }

  /* Background entries */
  .entry-group {
    margin: 1.75rem 0;
  }

  .group-label {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0 0 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--sol-7);
  }

  .group-label :global(svg) {
    flex-shrink: 0;
    opacity: 0.85;
  }

  .entries {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .entry {
    padding: 1rem 0;
    border-top: 1px solid var(--main-border-color);
  }

  :global([data-effective-theme="dark"]) .entry {
    border-color: var(--base03);
  }

  .entry h4 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 1.15rem;
    line-height: 1.3;
  }

  .entry-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.15rem 1em;
    margin: 0.3rem 0 0.4rem;
    color: var(--sol-7);
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .entry-role {
    color: var(--sol-8);
    font-weight: 600;
  }

  .entry-summary {
    margin: 0;
    color: var(--sol-8);
  }

  /* Interests */
  .interests {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .interest {
    padding: 1rem 1.1rem;
    border: 1px solid var(--main-border-color);
    border-radius: 8px;
    background: var(--base4);
  }

  :global([data-effective-theme="dark"]) .interest {
    border-color: var(--base03);
    background: var(--base02);
  }

  .interest h3 {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.4rem;
    font-size: 1.05rem;
    line-height: 1.3;
  }

  .interest p {
    margin: 0;
    color: var(--sol-8);
    font-size: 0.92rem;
    line-height: 1.55;
  }

  .note {
    color: var(--sol-8);
    font-size: 0.9rem;
  }

  a:focus-visible {
    outline: 2px solid var(--blue);
    outline-offset: 3px;
    border-radius: 2px;
  }

  @media (max-width: 600px) {
    .about {
      padding: 2rem 1.25rem 3rem;
    }

    .intro {
      grid-template-columns: 1fr;
    }

    .intro :global(.headshot) {
      width: 120px;
      height: 120px;
    }

    .interests {
      grid-template-columns: 1fr;
    }
  }
</style>
