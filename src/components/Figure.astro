---
import { Image } from "astro:assets";

interface Props {
  src: string | ImageMetadata;
  alt: string;
  caption?: string;
  width?: number;
  height?: number;
  class?: string;
  numbered?: boolean;
  fullWidth?: boolean;
  // Stable handle for cross-references. `<Figure id="clt-arch" …/>` anchors the
  // figure as `#fig-clt-arch`, which `[fig:clt-arch]` links to (see
  // remarkFigureRefs.mjs).
  id?: string;
}

const {
  src,
  alt,
  caption,
  width,
  height,
  class: className,
  numbered = true,
  fullWidth = false,
  id,
} = Astro.props;

const figureId = id ? `fig-${id}` : undefined;

// Determine if src is a string (path) or ImageMetadata object
const isImagePath = typeof src === "string";

// Auto-generate figure numbers using Astro.locals
let figureNumber: number | undefined;
if (numbered) {
  // Initialize counter if it doesn't exist
  if (!Astro.locals.figureCounter) {
    Astro.locals.figureCounter = 0;
  }
  // Increment and get the current figure number
  Astro.locals.figureCounter++;
  figureNumber = Astro.locals.figureCounter;
}
---

<figure
  id={figureId}
  class:list={["figure", className, fullWidth && "full-width"]}
>
  {
    isImagePath ? (
      <img
        src={src as string}
        alt={alt}
        width={width}
        height={height}
        loading="lazy"
      />
    ) : (
      <Image
        src={src as ImageMetadata}
        alt={alt}
        quality={90}
        width={width}
        widths={width ? [width, width * 2] : undefined}
        height={height}
        loading="lazy"
        decoding="async"
      />
    )
  }
  {
    caption && (
      <figcaption class="caption">
        {numbered && figureNumber && <strong>Figure {figureNumber}: </strong>}
        {caption}
      </figcaption>
    )
  }
</figure>

<style>
  .full-width {
    grid-column: 1 / 4 !important;
  }
  .figure {
    margin: 1rem 0;
    text-align: center;
    /* Keep a referenced figure clear of the viewport top when jumped to. */
    scroll-margin-top: 5rem;
    border-radius: 8px;
  }

  /* Brief highlight when arrived at via a [fig:…] reference. */
  @media (prefers-reduced-motion: no-preference) {
    .figure:target {
      animation: figure-target-flash 2s ease-out;
    }

    @keyframes figure-target-flash {
      0% {
        background: color-mix(in srgb, var(--blue) 16%, transparent);
        box-shadow: 0 0 0 0.5rem color-mix(in srgb, var(--blue) 16%, transparent);
      }
      100% {
        background: transparent;
        box-shadow: 0 0 0 0.5rem transparent;
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .figure:target {
      outline: 2px solid color-mix(in srgb, var(--blue) 55%, transparent);
      outline-offset: 0.4rem;
    }
  }

  .figure img {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
  }

  .caption {
    margin-top: 0.75rem;
    font-size: 0.9rem;
    font-style: italic;
    color: var(--sol-1);
    line-height: 1.4;
    max-width: min(90%, 800px);
    margin-left: auto;
    margin-right: auto;
  }

  .caption strong {
    font-style: normal;
    color: var(--sol-9);
  }

  /* Dark theme caption color */
  [data-effective-theme="dark"] .caption {
    color: var(--sol-0);
  }

  [data-effective-theme="dark"] .caption strong {
    color: var(--sol-10);
  }

  @media (max-width: 720px) {
    .figure {
      margin: 1.5rem 0;
    }

    .caption {
      font-size: 0.85rem;
      max-width: 90%;
    }
  }
</style>
