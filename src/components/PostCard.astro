---
import { Image } from "astro:assets";
import { ExternalLink } from "lucide-astro";
import GradientThumb from "./GradientThumb.astro";
import { getIconForType, getColorForType, capitalize } from "../utils/postIcons";

interface PostData {
  slug: string;
  title: string;
  description?: string;
  date?: Date;
  type?: string;
  status?: string;
  tags?: string[];
  image?: { path?: any; alt?: string };
  draft?: boolean;
  readingTimeText: string;
}

interface CardLink {
  label: string;
  href: string;
}

interface Props {
  post: PostData;
  variant?: "showcase" | "compact" | "mini";
  showDescription?: boolean;
  /** Replaces the tag/date/reading-time chunks after the type label (e.g. venue, role). */
  meta?: string[];
  /** Secondary links (paper, code) shown as a quiet row; the title still links to the post. */
  links?: CardLink[];
  /** Extra emphasized line under the description, e.g. a headline result. */
  highlight?: string;
  eager?: boolean;
}

const { post, variant = "compact", showDescription, meta, links, highlight, eager = false } = Astro.props;
const href = `/ideas/${post.slug}/`;
const isExternal = (url: string) => /^https?:\/\//.test(url);

const Icon = getIconForType(post.type);
const typeColor = getColorForType(post.type);

const shouldShowDescription = showDescription ?? true;

const metaDate = post.date
  ? post.date.toLocaleDateString("en-us", {
      year: "numeric",
      month: "short",
      day: "numeric",
    })
  : "";

const primaryTag = post.tags?.[0];

const gradientAspect =
  variant === "showcase" ? "16 / 10" : variant === "compact" ? "16 / 9" : "4 / 3";
---

<article class={`post-card post-card--${variant}`} data-type={post.type}>
  <div class="post-card-media">
    {post.image?.path ? (
      <Image
        src={post.image.path}
        alt={post.image.alt || ""}
        width={variant === "mini" ? 640 : 1200}
        loading={eager ? "eager" : "lazy"}
        fetchpriority={eager ? "high" : undefined}
      />
    ) : (
      <GradientThumb seed={post.slug} aspectRatio={gradientAspect} />
    )}
  </div>

  <div class="post-card-body">
    <div class="post-card-meta">
      {post.draft && <span class="draft-indicator">DRAFT</span>}
      {post.type && (
        <span class="meta-chunk type-chunk" style={typeColor && `color: ${typeColor}`}>
          {Icon && <Icon size={14} />}
          {capitalize(post.type)}
        </span>
      )}
      {meta ? (
        meta.map((chunk) => <span class="meta-chunk meta-chunk--plain">{chunk}</span>)
      ) : (
        <Fragment>
          {variant !== "mini" && primaryTag && (
            <span class="meta-chunk">{primaryTag}</span>
          )}
          {metaDate && <span class="meta-chunk">{metaDate}</span>}
          {post.readingTimeText && <span class="meta-chunk">{post.readingTimeText}</span>}
        </Fragment>
      )}
    </div>

    <h3 class="post-card-title"><a class="post-card-link" href={href}>{post.title}</a></h3>

    {shouldShowDescription && post.description && (
      <p class="post-card-description">{post.description}</p>
    )}

    {highlight && <p class="post-card-highlight" set:html={highlight} />}

    {links && links.length > 0 && (
      <div class="post-card-links">
        {links.map((link) => (
          isExternal(link.href) ? (
            <a href={link.href} target="_blank" rel="noopener noreferrer">
              {link.label}
              <ExternalLink class="post-card-link-icon" size={11} aria-hidden="true" />
              <span class="sr-only"> (opens in a new tab)</span>
            </a>
          ) : (
            <a href={link.href}>{link.label}</a>
          )
        ))}
      </div>
    )}
  </div>
</article>

<style>
  .post-card {
    position: relative;
    border: 1px solid var(--main-border-color);
    background-color: var(--base4);
    border-radius: 8px;
    overflow: hidden;
    color: inherit;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    height: 100%;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease,
      opacity 0.2s ease;
  }

  .post-card:hover {
    opacity: 0.92;
    transform: translateY(-2px);
  }

  /* The title link stretches over the whole card so the card stays one click target
     while the secondary links below remain separately clickable. */
  .post-card-link {
    color: inherit;
    text-decoration: none;
  }

  .post-card-link::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 2; /* global img rule sets z-index: 1 */
  }

  .post-card:has(.post-card-link:focus-visible) {
    outline: 2px solid var(--blue);
    outline-offset: 2px;
  }

  .post-card-link:focus-visible {
    outline: none;
  }

  .post-card-highlight {
    margin: 0;
    color: var(--sol-8);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .post-card-highlight :global(strong) {
    color: var(--sol-10);
    font-weight: 600;
  }

  :global([data-effective-theme="dark"]) .post-card-highlight :global(strong) {
    color: var(--sol-5);
  }

  .post-card-links {
    position: relative;
    z-index: 3;
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.1rem;
    margin-top: auto;
    padding-top: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.02em;
  }

  .post-card-links a {
    color: var(--sol-8);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
    padding-block: 0.3rem;
    transition: color 0.2s ease, text-decoration-color 0.2s ease;
  }

  .post-card-links :global(.post-card-link-icon) {
    margin-left: 0.2em;
    opacity: 0.72;
    vertical-align: -0.05em;
  }

  .post-card-links a:hover,
  .post-card-links a:focus-visible {
    color: var(--sol-10);
    text-decoration-color: currentColor;
  }

  :global([data-effective-theme="dark"]) .post-card-links a:hover {
    color: var(--sol-5);
  }

  .post-card-links a:focus-visible {
    outline: 2px solid var(--blue);
    outline-offset: 2px;
    border-radius: 2px;
  }

  .meta-chunk--plain {
    text-transform: none;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .post-card,
    .post-card:hover {
      transition: none;
      transform: none;
    }
  }

  :global([data-effective-theme="dark"]) .post-card {
    border: 1px solid var(--base03);
    background-color: var(--base02);
  }

  .post-card-media {
    width: 100%;
    overflow: hidden;
    background: var(--bg-2);
    display: grid;
    place-items: center;
  }

  .post-card-media :global(img),
  .post-card-media :global(.gradient-thumb) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .post-card-media :global(img) {
    object-fit: cover;
    object-position: center;
  }

  .post-card--showcase .post-card-media {
    aspect-ratio: 16 / 10;
  }

  .post-card--compact .post-card-media {
    aspect-ratio: 16 / 9;
  }

  .post-card--mini .post-card-media {
    aspect-ratio: 4 / 3;
  }

  .post-card-body {
    padding: 1rem 1.1rem 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    flex: 1;
  }

  .post-card--showcase .post-card-body {
    padding: 1.25rem 1.4rem 1.5rem;
    gap: 0.7rem;
  }

  .post-card--mini .post-card-body {
    padding: 0.85rem 0.95rem 1rem;
    gap: 0.4rem;
  }

  .post-card-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 1em;
    font-size: 0.75rem;
    text-transform: capitalize;
    color: var(--sol-7);
  }

  .post-card--mini .post-card-meta {
    font-size: 0.7rem;
    gap: 0.25rem 0.9em;
  }

  .meta-chunk {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    white-space: nowrap;
  }

  .type-chunk :global(svg) {
    flex-shrink: 0;
    vertical-align: middle;
  }

  .post-card-title {
    font-family: var(--font-heading);
    font-weight: 700;
    line-height: 1.2;
    margin: 0;
    color: var(--sol-10);
  }

  :global([data-effective-theme="dark"]) .post-card-title {
    color: var(--sol-5);
  }

  .post-card--showcase .post-card-title {
    font-size: clamp(1.5rem, 2.2vw, 1.9rem);
  }

  .post-card--compact .post-card-title {
    font-size: 1.2rem;
  }

  .post-card--mini .post-card-title {
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.25;
  }

  .post-card-description {
    margin: 0;
    color: var(--sol-8);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .post-card--compact .post-card-description,
  .post-card--mini .post-card-description {
    font-size: 0.85rem;
    line-height: 1.45;
  }

  .draft-indicator {
    color: var(--green);
    font-size: 0.6rem;
    font-weight: bold;
    padding: 2px 6px;
    border-radius: 3px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    font-family: var(--font-body);
  }
</style>
