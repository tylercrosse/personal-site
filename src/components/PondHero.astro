---
// Animated pond (WebGL2) behind the homepage intro, framed like the cards below.
// Without WebGL, or before the first frame, the CSS gradient shows instead.
// Reduced-motion users get a single still frame (handled in the engine).
---

<section class="pond-hero" data-pond-hero>
  <canvas aria-hidden="true"></canvas>
  <div class="pond-hero__content">
    <slot />
  </div>
</section>

<script>
  import { createPondWater } from "../scripts/pondWater.js";

  const hero = document.querySelector<HTMLElement>("[data-pond-hero]");
  const canvas = hero?.querySelector("canvas");
  if (hero && canvas) {
    createPondWater(canvas, {
      // Calm, darker water and no lilies behind the intro text.
      quietEl: hero.querySelector(".pond-hero__content"),
      lilyQuiet: 1.5,
      lilySpread: 0.6,
      onReady: () => hero.classList.add("is-ready"),
      onLost: () => hero.classList.remove("is-ready"),
    });
  }
</script>

<style>
  .pond-hero {
    position: relative;
    display: grid;
    place-items: center;
    max-width: 1200px;
    height: clamp(420px, 62svh, 640px);
    margin: 0 auto 2rem;
    overflow: hidden;
    border-radius: 8px;
    box-shadow: 0 0 0 1px var(--main-border-color);
    color: #fff;
    background:
      radial-gradient(60% 35% at 40% 12%, rgba(120, 200, 225, 0.55), transparent 70%),
      linear-gradient(
        162deg,
        #2f8fb6 0%,
        #1f6b2a 30%,
        #0b3a1c 55%,
        #1f6b2a 72%,
        #3f9cc4 90%,
        #1f6b2a 100%
      );
  }

  :global([data-effective-theme="dark"]) .pond-hero {
    box-shadow: none;
  }

  .pond-hero canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    opacity: 0;
    transition: opacity 1.2s ease;
  }

  .pond-hero.is-ready canvas {
    opacity: 1;
  }

  .pond-hero__content {
    position: relative;
    z-index: 1;
    padding: 0 16px;
    text-align: center;
  }

  @media (prefers-reduced-motion: reduce) {
    .pond-hero canvas {
      transition: none;
    }
  }
</style>
