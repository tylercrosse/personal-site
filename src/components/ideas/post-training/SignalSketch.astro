---
/**
 * A small diagram of what one learning signal looks like, for the left pane
 * of the "Methods, sorted by what the model learns from" ScrollyMap. One per
 * family, under that step's paragraph:
 *
 *   <SignalSketch kind="demo" />      demonstrations: prompt → target ✓
 *   <SignalSketch kind="pref" />      preferences: chosen ✓ over rejected ✕
 *   <SignalSketch kind="reward" />    scalar rewards: three attempts, a score each
 *   <SignalSketch kind="teacher" />   teacher distributions: teacher's next-token
 *                                     probabilities, the student's against them
 *
 * variant="sketch" (default) draws text as placeholder lines and is
 * decorative (aria-hidden): the paragraph above says the same thing.
 * variant="example" fills the same layout with the cows problem from the
 * token figure (token-signals.json: the teacher's answer, the student's
 * wrong answer, three of its sixteen samples, and the teacher's and
 * student's probabilities at two of its tokens). That adds information, so
 * it carries an aria-label instead.
 *
 * Colours are the post-training map's family colours (light and dark), and
 * the boxes follow DataExamples / AnnotatedExample: bg-1, hairline border,
 * mono uppercase labels, green/red for good/bad.
 *
 * Not a numbered figure: don't import it under a name ending in "Figure".
 */
import data from "./token-signals.json";

type Kind = "demo" | "pref" | "reward" | "teacher";

interface Props {
  kind: Kind;
  variant?: "sketch" | "example";
}

const { kind, variant = "sketch" } = Astro.props;
const ex = variant === "example";

const LABEL: Record<Kind, string> = {
  demo: "Target response",
  pref: "Chosen vs. rejected",
  reward: "A score for each attempt",
  teacher: "Next-token probabilities",
};

// ---- the cows example, from token-signals.json
const question = data.question;
const key = data.gold;
const tok = (t: string) => data.student.tokens.find((x) => x.t === t)!;
const flagged = [tok(" /"), tok(" left")].map((x) => ({
  t: x.t.trim(),
  pick: x.teacherTop.trim(),
  s: x.pStudent,
  te: x.pTeacher,
}));
const fmt = (p: number) => (p >= 0.01 ? p.toFixed(2) : p < 0.001 ? p.toFixed(4) : p.toFixed(3));

const ARIA: Record<Kind, string> = {
  demo: `A demonstration: the cows word problem as the prompt, and the teacher's correct answer, ending "28 + 5 = 33 cows", as the target.`,
  pref: `A preference pair for the cows word problem: the teacher's answer ending in 33, chosen, over the student's answer ending in 19, rejected.`,
  reward: `Three of the student's attempts at the cows word problem, checked against the answer key, ${key}: the one ending in 33 scores 1, the two ending in 19 and 39 score 0.`,
  teacher: `The teacher's probabilities at two tokens of the student's wrong answer. At "/", the student gave ${fmt(flagged[0].s)} and the teacher ${fmt(flagged[0].te)}; the teacher would have written "${flagged[0].pick}". At "left", the student gave ${fmt(flagged[1].s)} and the teacher ${fmt(flagged[1].te)}; the teacher would have written "${flagged[1].pick}".`,
};

// ---- placeholder geometry for the sketch variant
const rollouts = [
  { w: 78, score: 1.2 },
  { w: 64, score: 0.3 },
  { w: 71, score: -0.8 },
];
const exRollouts = [
  { text: "…he has 42 - 14 = 28 cows. … 28 + 5 = 33 cows.", score: 1 },
  { text: "…there are 42 / 3 = 14 cows left. … 14 + 5 = 19 cows.", score: 0 },
  { text: "…42 * (1 - 1/3) = 34 cows left. … 34 + 5 = 39 cows.", score: 0 },
];
const maxScore = 1.2;
// Teacher's distribution over five candidate tokens, and the student's before it matches.
const teacherP = [0.12, 0.58, 0.16, 0.09, 0.05];
const studentP = [0.22, 0.3, 0.27, 0.13, 0.08];
const tokenW = [18, 30, 14, 24, 20, 12];

const check = `<svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="8"/><path d="M4.6 8.3l2.2 2.2 4.6-4.8"/></svg>`;
const cross = `<svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="8"/><path d="M5.4 5.4l5.2 5.2M10.6 5.4l-5.2 5.2"/></svg>`;
---

<div
  class:list={["sig", `sig-${kind}`, { "sig-ex": ex }]}
  aria-hidden={ex ? undefined : "true"}
  role={ex ? "img" : undefined}
  aria-label={ex ? ARIA[kind] : undefined}
>
  <div class="sig-head">
    <span class="sig-label">{LABEL[kind]}</span>
    {ex && kind === "reward" && <span class="sig-key">Answer key: {key}</span>}
  </div>

  <div class="box prompt">
    <span class="tag">Prompt</span>
    {
      ex ? (
        <span class="txt">{question}</span>
      ) : (
        <span class="lines">
          <i style="width: 84%" />
        </span>
      )
    }
  </div>

  {
    kind === "demo" && (
      <div class="box resp good">
        <span class="tag">Target</span>
        {ex ? (
          <span class="txt">
            …which is 42 / 3 = 14 cows. After selling, he has 42 - 14 = 28 cows. Then he buys 5 more, so he now has 28
            + 5 = 33 cows.
          </span>
        ) : (
          <span class="lines">
            <i style="width: 96%" />
            <i style="width: 88%" />
            <i style="width: 52%" />
          </span>
        )}
        <span class="mark ok" set:html={check} />
      </div>
    )
  }

  {
    kind === "pref" && (
      <div class="pair">
        <div class="box resp good">
          <span class="tag">Chosen</span>
          {ex ? (
            <span class="txt">…he has 42 - 14 = 28 cows. Then he buys 5 more, so he now has 28 + 5 = 33 cows.</span>
          ) : (
            <span class="lines">
              <i style="width: 94%" />
              <i style="width: 80%" />
              <i style="width: 46%" />
            </span>
          )}
          <span class="mark ok" set:html={check} />
        </div>
        <span class="over">≻</span>
        <div class="box resp bad">
          <span class="tag">Rejected</span>
          {ex ? (
            <span class="txt">…there are 42 / 3 = 14 cows left. Then 14 + 5 = 19 cows.</span>
          ) : (
            <span class="lines">
              <i style="width: 90%" />
              <i style="width: 84%" />
              <i style="width: 38%" />
            </span>
          )}
          <span class="mark no" set:html={cross} />
        </div>
      </div>
    )
  }

  {
    kind === "reward" && (
      <div class="rollouts">
        {(ex ? exRollouts : rollouts).map((r: { w?: number; text?: string; score: number }) => (
          <div class="rollout">
            <div class="box resp">
              {ex ? <span class="txt">{r.text}</span> : <span class="lines">
                <i style={`width: ${r.w}%`} />
              </span>}
            </div>
            <span class="score">
              <span class="num">{r.score < 0 ? `−${Math.abs(r.score).toFixed(ex ? 0 : 1)}` : r.score.toFixed(ex ? 0 : 1)}</span>
              <span class="track">
                <span
                  class:list={["fill", { neg: r.score < 0 }]}
                  style={`width: ${ex ? r.score * 100 : (Math.abs(r.score) / maxScore) * 50}%`}
                />
              </span>
            </span>
          </div>
        ))}
      </div>
    )
  }

  {
    kind === "teacher" && !ex && (
      <div class="box resp">
        <span class="toks">
          {tokenW.map((w) => (
            <i style={`width: ${w}px`} />
          ))}
          <b class="slot">?</b>
        </span>
        <div class="dists">
          <div class="dist">
            <span class="bars">
              {teacherP.map((p) => (
                <i class="t" style={`height: ${(p / 0.6) * 100}%`} />
              ))}
            </span>
            <span class="cap">Teacher</span>
          </div>
          <span class="arrow">→</span>
          <div class="dist">
            <span class="bars">
              {studentP.map((p, k) => (
                <span class="slotbar">
                  <i class="s" style={`height: ${(p / 0.6) * 100}%`} />
                  <i class="ghost" style={`bottom: ${(teacherP[k] / 0.6) * 100}%`} />
                </span>
              ))}
            </span>
            <span class="cap">Student, matching it</span>
          </div>
        </div>
      </div>
    )
  }

  {
    kind === "teacher" && ex && (
      <div class="box resp">
        <span class="tag">Student's answer</span>
        <span class="txt">
          …there are 42 <mark>/</mark> 3 = 14 cows <mark>left</mark>. Then 14 + 5 = 19 cows.
        </span>
        <div class="probs">
          <span />
          <span class="h">Student</span>
          <span class="h">Teacher</span>
          <span class="h">Teacher's pick</span>
          {flagged.map((f) => (
            <>
              <span class="tk">“{f.t}”</span>
              <span class="pv">
                <span class="htrack"><span class="hbar s" style={`width: ${f.s * 100}%`} /></span>
                {fmt(f.s)}
              </span>
              <span class="pv">
                <span class="htrack"><span class="hbar t" style={`width: ${Math.max(f.te * 100, 3)}%`} /></span>
                {fmt(f.te)}
              </span>
              <span class="tk pick">“{f.pick}”</span>
            </>
          ))}
        </div>
      </div>
    )
  }
</div>

<style>
  /* Family colours: the post-training map's light and dark values. Good/bad as in DataExamples. */
  .sig {
    --demo: #2e8b57;
    --pref: #b7791f;
    --reward: #8a55c2;
    --teacher: #2f6fb8;
    --good: #2e8b57;
    --bad: #c94a4a;
    --sig-border: color-mix(in srgb, rgb(var(--gray-dark)) 11%, rgb(var(--gray-light)));
    --ink-faint: color-mix(in srgb, currentColor 26%, transparent);
    --mono: var(--font-mono);
  }

  :global([data-effective-theme="dark"]) .sig {
    --demo: #6fbf8e;
    --pref: #e8b04a;
    --reward: #b48ad8;
    --teacher: #6aa2e0;
    --good: #6fbf8e;
    --bad: #e07a7a;
    --sig-border: color-mix(in srgb, rgb(var(--gray-dark)) 14%, rgb(var(--gray-light)));
    --ink-faint: color-mix(in srgb, currentColor 30%, transparent);
  }

  .sig-demo { --c: var(--demo); }
  .sig-pref { --c: var(--pref); }
  .sig-reward { --c: var(--reward); }
  .sig-teacher { --c: var(--teacher); }

  .sig {
    max-width: 26rem;
    margin: 0.85rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 0.72rem;
    line-height: 1.4;
    text-align: left;
  }

  .sig-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }

  .sig-label,
  .sig-key {
    font-family: var(--mono);
    font-size: 0.66rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--c);
  }

  .sig-key {
    color: inherit;
    opacity: 0.7;
  }

  /* ---- boxes */
  .box {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 6px 9px 7px;
    border: 1px solid var(--sig-border);
    border-radius: 6px;
    background: var(--bg-1);
    box-sizing: border-box;
    min-width: 0;
  }

  .prompt {
    align-self: flex-start;
    width: 72%;
    border-radius: 8px 8px 8px 2px;
  }

  .sig-ex .prompt {
    width: 88%;
  }

  .resp {
    margin-left: 1.25rem;
  }

  .resp.good {
    border-left: 2px solid var(--good);
  }

  .resp.bad {
    border-left: 2px solid var(--bad);
  }

  .tag {
    font-family: var(--mono);
    font-size: 0.6rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0.6;
  }

  .txt {
    overflow-wrap: anywhere;
  }

  /* placeholder text */
  .lines {
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: 2px 0 1px;
  }

  .lines i {
    display: block;
    height: 4px;
    border-radius: 2px;
    background: var(--ink-faint);
  }

  /* ✓ and ✕ */
  .mark {
    position: absolute;
    top: 6px;
    right: 7px;
    width: 14px;
    height: 14px;
  }

  .mark :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .mark :global(circle) {
    fill: var(--m);
  }

  .mark :global(path) {
    fill: none;
    stroke: var(--bg-0);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .mark.ok { --m: var(--good); }
  .mark.no { --m: var(--bad); }

  .resp:has(.mark) .tag,
  .resp:has(.mark) .txt {
    padding-right: 18px;
  }

  /* ---- preferences: two answers side by side */
  .pair {
    margin-left: 1.25rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: stretch;
    gap: 6px;
  }

  .pair .resp {
    margin-left: 0;
  }

  .over {
    align-self: center;
    font-size: 0.95rem;
    color: var(--c);
  }

  /* ---- scalar rewards: attempts and their scores */
  .rollouts {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .rollout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 5.5rem;
    align-items: center;
    gap: 8px;
  }

  .rollout .resp {
    padding-block: 5px;
  }

  .rollout .lines {
    padding: 1px 0;
  }

  .score {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .num {
    flex: none;
    width: 2.6em;
    white-space: nowrap;
    text-align: right;
    font-family: var(--mono);
    font-size: 0.7rem;
    font-variant-numeric: tabular-nums;
    color: var(--c);
  }

  .track {
    position: relative;
    flex: 1;
    height: 6px;
  }

  /* zero line */
  .track::before {
    content: "";
    position: absolute;
    left: 50%;
    top: -2px;
    bottom: -2px;
    width: 1px;
    background: var(--ink-faint);
  }

  .fill {
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    border-radius: 0 2px 2px 0;
    background: var(--c);
  }

  .fill.neg {
    left: auto;
    right: 50%;
    border-radius: 2px 0 0 2px;
    background: color-mix(in srgb, var(--c) 50%, transparent);
  }

  .sig-ex .rollout {
    grid-template-columns: minmax(0, 1fr) 4.2rem;
  }

  .sig-ex .track::before {
    left: 0;
  }

  .sig-ex .fill {
    left: 0;
  }

  /* ---- teacher distributions */
  .toks {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 3px;
  }

  .toks i {
    display: block;
    height: 7px;
    border-radius: 2px;
    background: var(--ink-faint);
  }

  .slot {
    display: inline-grid;
    place-items: center;
    width: 18px;
    height: 13px;
    border: 1.5px solid var(--c);
    border-radius: 3px;
    font-family: var(--mono);
    font-size: 0.6rem;
    font-weight: 600;
    line-height: 1;
    color: var(--c);
    box-sizing: border-box;
  }

  .dists {
    display: flex;
    align-items: flex-start;
    gap: 18px;
    margin-top: 6px;
  }

  .dist {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .bars {
    display: flex;
    align-items: flex-end;
    gap: 4px;
    height: 40px;
    padding-bottom: 1px;
    border-bottom: 1px solid var(--ink-faint);
  }

  .bars i {
    display: block;
    width: 12px;
    border-radius: 1.5px 1.5px 0 0;
  }

  .bars .t {
    background: var(--c);
  }

  .slotbar {
    position: relative;
    display: flex;
    align-items: flex-end;
    width: 12px;
    height: 100%;
  }

  .slotbar .s {
    position: relative;
    width: 100%;
    background: color-mix(in srgb, var(--c) 42%, transparent);
  }

  /* the teacher's value, as a mark the student's bar is pulled toward */
  .slotbar .ghost {
    position: absolute;
    left: -2px;
    right: -2px;
    width: auto;
    height: 2px;
    margin-bottom: -1px;
    border-radius: 1px;
    background: var(--c);
  }

  .arrow {
    align-self: center;
    margin-top: -12px;
    opacity: 0.55;
  }

  .cap {
    font-family: var(--mono);
    font-size: 0.6rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0.6;
  }

  /* example: the student's answer with the teacher's view of two tokens */
  mark {
    color: inherit;
    background: color-mix(in srgb, var(--c) 18%, transparent);
    border-bottom: 1.5px solid var(--c);
    border-radius: 2px 2px 0 0;
    padding: 0 0.15em;
  }

  .probs {
    display: grid;
    grid-template-columns: repeat(4, auto);
    justify-content: start;
    align-items: center;
    gap: 2px 14px;
    margin-top: 3px;
  }

  .probs .h {
    font-family: var(--mono);
    font-size: 0.58rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0.6;
  }

  .tk {
    font-family: var(--mono);
    font-size: 0.68rem;
  }

  .tk.pick {
    color: var(--c);
  }

  .pv {
    display: flex;
    align-items: center;
    gap: 5px;
    font-family: var(--mono);
    font-size: 0.66rem;
    font-variant-numeric: tabular-nums;
  }

  .htrack {
    flex: none;
    width: 2.25rem;
  }

  .hbar {
    display: block;
    height: 6px;
    border-radius: 0 2px 2px 0;
  }

  .hbar.s {
    background: color-mix(in srgb, var(--c) 42%, transparent);
  }

  .hbar.t {
    background: var(--c);
  }
</style>
