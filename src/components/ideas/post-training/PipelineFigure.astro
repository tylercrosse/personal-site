    { x: 38, y: 594, w: 148, h: 42, title: "…", sub: ["office, tool use, more"], fam: "split", dashed: true },
    { x: 222, y: 358, w: 122, h: 58, title: "Student", sub: ["mixed-environment", "RLVR"], fam: "rl", core: true, simple: SIMPLE.rl },
