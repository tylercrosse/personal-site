    { d: "M185,232 V262", core: true },
    { d: "M240,314 C240,336 283,330 283,352", core: true },
    { d: "M130,314 C130,336 111,332 111,352" },
    { d: "M222,387 H204", dashed: true },
    { d: "M283,416 V458" },
    { d: "M283,416 V688", simpleOnly: true },
    { d: "M111,648 V688", tone: "teacher" },
    { d: "M283,522 V688" },
    { d: "M26,725 H22 Q14,725 14,717 V511 Q14,503 22,503 H24", dashed: true },
