// Vertical positions of a node's title and subtitle lines.
function textRows(n: { y: number; h: number }, sub: string[], layout: Layout) {
  const cy = n.y + n.h / 2;
  const lh = layout.s + 3;
  const block = layout.t + sub.length * lh;
  const top = cy - block / 2;
  return {
    title: top + layout.t / 2 + 1,
    subs: sub.map((_, i) => top + layout.t + 3 + lh * i + layout.s / 2),
  };
}

const layouts = [wide, narrow];
---

<figure id={figureId} class="figure pt-figure">
  <div class="pt-canvas" role="img" aria-label={alt}>
    {
      layouts.map((L) => (
        <svg
          class:list={["pt-svg", L.key === "w" ? "pt-wide" : "pt-narrow"]}
          viewBox={`0 0 ${L.w} ${L.h}`}
          style={`--pt-t: ${L.t}px; --pt-s: ${L.s}px; max-width: ${L.key === "w" ? L.w : 440}px`}
          aria-hidden="true"
          focusable="false"
        >
          <defs>
            <marker
              id={`pt-${L.key}-arr`}
              viewBox="0 0 10 10"
              refX="8"
              refY="5"
              markerWidth="7"
              markerHeight="7"
              orient="auto"
            >
              <path d="M0,1 L9,5 L0,9 z" class="pt-arrowhead" />
            </marker>
            <marker
              id={`pt-${L.key}-arr-t`}
              viewBox="0 0 10 10"
              refX="8"
              refY="5"
              markerWidth="7"
              markerHeight="7"
              orient="auto"
            >
              <path d="M0,1 L9,5 L0,9 z" class="pt-arrowhead teacher" />
            </marker>
            <linearGradient id={`pt-${L.key}-split`} x1="0" x2="1" y1="0" y2="0">
              <stop offset="0" class="pt-stop-sft" />
              <stop offset="0.5" class="pt-stop-sft" />
              <stop offset="0.5" class="pt-stop-rl" />
              <stop offset="1" class="pt-stop-rl" />
            </linearGradient>
          </defs>

          {L.regions.map((r) => (
            <g class:list={["pt-region", r.kind, "pt-extra", "lag-0"]}>
              <rect x={r.x} y={r.y} width={r.w} height={r.h} rx={r.kind === "mid" ? 8 : 12} />
              <text class="pt-region-label" x={r.lx} y={r.ly}>
                {r.label}
              </text>
            </g>
          ))}

          <rect
            class="pt-group pt-extra lag-1"
            x={L.group.x}
            y={L.group.y}
            width={L.group.w}
            height={L.group.h}
            rx="10"
          />

          {L.edges.map((e) => (
            <path
              class:list={[
                "pt-edge",
                e.dashed && "dashed",
                e.tone,
                e.simpleOnly ? "pt-simple-only" : !e.core && "pt-extra lag-2",
              ]}
              d={e.d}
              marker-end={`url(#pt-${L.key}-arr${e.tone === "teacher" ? "-t" : ""})`}
            />
          ))}

          {L.nodes.map((n) => {
            const full = textRows(n, n.sub ?? [], L);
            const simple = n.simple && textRows(n, n.simple.sub ?? [], L);
            const cx = n.x + n.w / 2;
            return (
              <g class:list={["pt-node", n.fam, n.dashed && "dashed", !n.core && "pt-extra lag-1"]}>
                <rect
                  x={n.x}
                  y={n.y}
                  width={n.w}
                  height={n.h}
                  rx={n.fam === "model" ? n.h / 2 : 6}
                  style={n.fam === "split" ? `stroke: url(#pt-${L.key}-split)` : undefined}
                />
                <g class:list={[n.simple && "pt-full-text"]}>
                  <text class="pt-title" x={cx} y={full.title}>
                    {n.title}
                  </text>
                  {(n.sub ?? []).map((line, i) => (
                    <text class="pt-sub" x={cx} y={full.subs[i]}>
                      {line}
                    </text>
                  ))}
                </g>
                {n.simple && simple && (
                  <g class="pt-simple-text">
                    <text class="pt-title" x={cx} y={simple.title}>
                      {n.simple.title}
                    </text>
                    {(n.simple.sub ?? []).map((line, i) => (
                      <text class="pt-sub" x={cx} y={simple.subs[i]}>
                        {line}
                      </text>
                    ))}
                  </g>
                )}
              </g>
            );
          })}

          {L.labels.map((l) => (
            <text
              class:list={["pt-head", l.tone, "pt-extra", "lag-2"]}
              x={l.x}
              y={l.y}
              text-anchor={l.anchor ?? "start"}
              transform={l.rotate ? `rotate(-90 ${l.x} ${l.y})` : undefined}
            >
              {l.text}
            </text>
          ))}
        </svg>
      ))
    }

    <ul class="pt-key" aria-hidden="true">
      <li><span class="sw sft"></span>SFT · demonstrations</li>
      <li><span class="sw rl"></span>RL · scalar rewards</li>
      <li><span class="sw distill"></span>Distillation · teacher distributions</li>
      <li class="pt-key-extra"><span class="sw split"></span>SFT or RL, per teacher</li>
      <li class="pt-key-extra"><span class="sw pre"></span>Pretraining</li>
    </ul>
  </div>
  {
    caption && (
      <figcaption class="caption">
        {numbered && figureNumber && <strong>Figure {figureNumber}: </strong>}
        {caption}
      </figcaption>
    )
  }
</figure>

<script>
  const figures = document.querySelectorAll<HTMLElement>(".pt-figure");

  // While the wide drawing is on screen it runs under the desktop table of
  // contents; fade the ToC out, as ScrollyMap does for the map.
  if (figures.length && "IntersectionObserver" in window) {
    const visible = new Set<Element>();
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          const wide = e.target.querySelector(".pt-wide");
          const shown = wide && getComputedStyle(wide).display !== "none";
          if (e.isIntersecting && shown) visible.add(e.target);
          else visible.delete(e.target);
        }
        document.documentElement.classList.toggle("pt-figure-in-view", visible.size > 0);
      },
      { rootMargin: "-10% 0px -10% 0px" },
    );
    figures.forEach((f) => io.observe(f));
  }

  // Simple first. Stage the wide drawing (core boxes only) while it is still
  // below the fold, then reveal the full figure once the reader has the
  // drawing on screen. Staging is skipped whenever the reader might land on
  // the figure directly; every path out of it ends in the full figure.
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (!reduced && "IntersectionObserver" in window) {
    figures.forEach((fig) => {
      const svg = fig.querySelector<SVGSVGElement>(".pt-wide");
      if (!svg || getComputedStyle(svg).display === "none") return;
      if (fig.id && location.hash === `#${fig.id}`) return;
      // Already on screen (or above it, e.g. a restored scroll position).
      if (svg.getBoundingClientRect().top < window.innerHeight) return;

      fig.classList.add("is-staged");

      let dwell: number | undefined;
      let settle: number | undefined;
      const reveal = () => {
        if (!fig.classList.contains("is-staged")) return;
        fig.classList.remove("is-staged");
        window.clearTimeout(dwell);
        window.clearTimeout(settle);
        io.disconnect();
        window.removeEventListener("hashchange", onHash);
        window.removeEventListener("beforeprint", reveal);
      };
      const onHash = () => {
        if (location.hash === `#${fig.id}`) reveal();
      };

      const io = new IntersectionObserver(
        ([e]) => {
          const r = e.boundingClientRect;
          // Scrolled past the top, or jumped beyond it: no simple state.
          if (r.top < 0 || (!e.isIntersecting && r.bottom < 0)) return reveal();
          // The whole drawing is in view: a short beat, then fill it in.
          if (e.intersectionRatio > 0.97 && settle === undefined) {
            settle = window.setTimeout(reveal, 800);
          }
          // Most of it is in view (short windows): don't wait for the rest.
          if (e.intersectionRatio > 0.45 && dwell === undefined) {
            dwell = window.setTimeout(reveal, 2000);
          }
        },
        { threshold: [0, 0.45, 0.6, 0.8, 0.98, 1] },
      );
      io.observe(svg);

      window.addEventListener("hashchange", onHash);
      window.addEventListener("beforeprint", reveal);
      fig.addEventListener("pointerdown", reveal, { once: true });
      fig.addEventListener("focusin", reveal, { once: true });
    });
  }
</script>

<style is:global>
  html.pt-figure-in-view .desktop-toc {
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
  }

  html.pt-figure-in-view .desktop-toc :is(a, button) {
    visibility: hidden;
  }
</style>

<style>
  /* Theme tokens. Family colours and greys are the explorer's light and
     dark values, so these boxes read as the same parts as the map's. */
  .pt-figure {
    --pt-demo: #2e8b57;
    --pt-reward: #8a55c2;
    --pt-teacher: #2f6fb8;
    --pt-neutral: #7a7f87;
    --pt-surface: var(--bg-1);
    --pt-text: #1c1e22;
    --pt-muted: #5d6168;
    --pt-faint: #878b92;
    --pt-line-strong: #a7abb1;
    --pt-edge: #8f949b;
    --pt-band: color-mix(in srgb, var(--pt-neutral) 7%, var(--pt-surface));
    --pt-region: #6b7078;
  }

  :global([data-effective-theme="dark"]) .pt-figure {
    --pt-demo: #6fbf8e;
    --pt-reward: #b48ad8;
    --pt-teacher: #6aa2e0;
    --pt-neutral: #8c919a;
    --pt-text: #eee8d5;
    --pt-muted: #93a1a1;
    --pt-faint: #7d9599;
    --pt-line-strong: #4d7f8b;
    --pt-edge: #6f8f95;
    --pt-band: color-mix(in srgb, var(--pt-neutral) 9%, var(--pt-surface));
    --pt-region: #8fa3a5;
  }

  .pt-figure {
    /* Break out of the 800px text column; the canvas caps the width. */
    grid-column: 1 / -1 !important;
    margin: 1.5rem 0;
    scroll-margin-top: 5rem;
    border-radius: 8px;
  }

  .pt-canvas {
    container-type: inline-size;
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1rem;
    box-sizing: border-box;
  }

  @media (max-width: 720px) {
    .pt-canvas {
      padding: 0;
    }
  }

  .pt-svg {
    display: block;
    width: 100%;
    height: auto;
    margin: 0 auto;
    overflow: visible;
    font-family: var(--font-body);
  }

  .pt-wide {
    display: none;
  }

  /* Below ~940px the wide drawing's labels would shrink under ~10px. */
  @container (min-width: 940px) {
    .pt-wide {
      display: block;
    }
    .pt-narrow {
      display: none;
    }
  }

  /* ---- nodes, after the map's .node boxes */
  .pt-node {
    --c: var(--pt-neutral);
  }
  .pt-node.sft {
    --c: var(--pt-demo);
  }
  .pt-node.rl {
    --c: var(--pt-reward);
  }
  .pt-node.distill {
    --c: var(--pt-teacher);
  }

  .pt-node rect {
    fill: color-mix(in srgb, var(--c) 11%, var(--pt-surface));
    stroke: var(--c);
    stroke-width: 1.5;
  }

  .pt-node.pre rect,
  .pt-node.split rect {
    fill: var(--pt-surface);
  }

  .pt-node.model rect {
    fill: var(--pt-surface);
    stroke: var(--pt-line-strong);
    stroke-width: 1.25;
  }

  .pt-node.dashed rect {
    stroke-dasharray: 5 3;
  }

  .pt-stop-sft {
    stop-color: var(--pt-demo);
  }
  .pt-stop-rl {
    stop-color: var(--pt-reward);
  }

  .pt-title,
  .pt-sub {
    text-anchor: middle;
    dominant-baseline: central;
  }

  .pt-title {
    font-size: var(--pt-t);
    font-weight: 600;
    fill: var(--pt-text);
  }

  .pt-sub {
    font-size: var(--pt-s);
    fill: var(--pt-muted);
  }

  /* ---- edges: the map's thin curves, with small arrowheads */
