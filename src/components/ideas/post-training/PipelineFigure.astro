---
/**
 * The 2026 post-training pipeline, drawn in the post-training map's node and
 * edge language so it follows the site theme.
 *
 *   <PipelineFigure id="pipeline" alt="…" caption="…" />
 *
 * Stages are coloured by the learning signal they train on, with the map's
 * family colours (notes/post-training-study-project/explorer/index.html):
 * green = demonstrations (SFT), purple = scalar rewards (RL), blue = teacher
 * distributions (distillation). Pretraining stays neutral. Specialist
 * teachers get the map's split border because each one gets SFT or RL.
 * Dashed boxes are steps only some recipes use. Quiet shaded bands mark the
 * pretraining and post-training regions, with a dashed midtraining slice.
 *
 * Two drawings of the same graph: a wide one that breaks out of the text
 * column on desktop, and a vertical one for phones. A container query picks
 * one, so a narrow column never shrinks the wide drawing past legibility.
 *
 * Simple first: on the wide drawing, the script stages the figure before it
 * scrolls into view so it shows only the "core" parts (base model, SFT, RL,
 * distillation, shipped model) with plain labels, then fades the rest in
 * once the reader has it on screen. The core boxes never move. The markup
 * and CSS default to the full figure, so without JavaScript, under reduced
 * motion, and on the vertical drawing the full figure shows statically.
 *
 * Name ends in "Figure" so remarkCrossRefs counts it; it shares
 * Astro.locals.figureCounter with Figure.astro so the printed number matches.
 */
interface Props {
  alt: string;
  caption?: string;
  numbered?: boolean;
  /** Cross-reference target; `id="foo"` is reachable as `[fig:foo]`. */
  id?: string;
}

const { alt, caption, numbered = true, id } = Astro.props;
const figureId = id ? `fig-${id}` : undefined;

let figureNumber: number | undefined;
if (numbered) {
  if (!Astro.locals.figureCounter) Astro.locals.figureCounter = 0;
  Astro.locals.figureCounter++;
  figureNumber = Astro.locals.figureCounter;
}

type Fam = "pre" | "sft" | "rl" | "distill" | "split" | "model";
type Node = {
  x: number;
  y: number;
  w: number;
  h: number;
  title: string;
  sub?: string[];
  fam: Fam;
  dashed?: boolean;
  /** Shown in the simple first state. */
  core?: boolean;
  /** Plain labels for the simple state; the full labels fade in over them. */
  simple?: { title: string; sub?: string[] };
};
type Edge = {
  d: string;
  dashed?: boolean;
  tone?: "teacher";
  core?: boolean;
  /** Only drawn in the simple state (a shortcut the full figure routes around). */
  simpleOnly?: boolean;
};
type Label = {
  x: number;
  y: number;
  text: string;
  anchor?: "start" | "middle" | "end";
  rotate?: boolean;
  tone?: "teacher";
};
/** A shaded band behind a phase of training. */
type Region = {
  x: number;
  y: number;
  w: number;
  h: number;
  kind: "pre" | "mid" | "post";
  label: string;
  lx: number;
  ly: number;
};
type Layout = {
  key: string;
  w: number;
  h: number;
  /** Title and subtitle sizes (px in viewBox units). */
  t: number;
  s: number;
  regions: Region[];
  group: { x: number; y: number; w: number; h: number };
  nodes: Node[];
  edges: Edge[];
  labels: Label[];
};

const SIMPLE = {
  sft: { title: "SFT", sub: ["learn from demonstrations"] },
  rl: { title: "RL", sub: ["learn from rewards"] },
  distill: { title: "Distillation", sub: ["learn from teachers"] },
};

// ---- wide: the original diagram's arrangement, ~1100 units across
const wide: Layout = {
