// Vertical positions of a node's title and subtitle lines.
function textRows(n: Node, layout: Layout) {
  const cy = n.y + n.h / 2;
  const subs = n.sub ?? [];
  const lh = layout.s + 3;
  const block = layout.t + subs.length * lh;
  const top = cy - block / 2;
  return {
    title: top + layout.t / 2 + 1,
    subs: subs.map((_, i) => top + layout.t + 3 + lh * i + layout.s / 2),
  };
}

const layouts = [wide, narrow];
---

<figure id={figureId} class="figure pt-figure">
  <div class="pt-canvas" role="img" aria-label={alt}>
    {
      layouts.map((L) => (
        <svg
          class:list={["pt-svg", L.key === "w" ? "pt-wide" : "pt-narrow"]}
          viewBox={`0 0 ${L.w} ${L.h}`}
          style={`--pt-t: ${L.t}px; --pt-s: ${L.s}px; max-width: ${L.key === "w" ? L.w : 440}px`}
          aria-hidden="true"
          focusable="false"
        >
          <defs>
            <marker
              id={`pt-${L.key}-arr`}
              viewBox="0 0 10 10"
              refX="8"
              refY="5"
              markerWidth="7"
              markerHeight="7"
              orient="auto"
            >
              <path d="M0,1 L9,5 L0,9 z" class="pt-arrowhead" />
            </marker>
            <marker
              id={`pt-${L.key}-arr-t`}
              viewBox="0 0 10 10"
              refX="8"
              refY="5"
              markerWidth="7"
              markerHeight="7"
              orient="auto"
            >
              <path d="M0,1 L9,5 L0,9 z" class="pt-arrowhead teacher" />
            </marker>
            <linearGradient id={`pt-${L.key}-split`} x1="0" x2="1" y1="0" y2="0">
              <stop offset="0" class="pt-stop-sft" />
              <stop offset="0.5" class="pt-stop-sft" />
              <stop offset="0.5" class="pt-stop-rl" />
              <stop offset="1" class="pt-stop-rl" />
            </linearGradient>
          </defs>

          <rect
            class="pt-group"
            x={L.group.x}
            y={L.group.y}
            width={L.group.w}
            height={L.group.h}
            rx="10"
          />

          {L.edges.map((e) => (
            <path
              class:list={["pt-edge", e.dashed && "dashed", e.tone]}
              d={e.d}
              marker-end={`url(#pt-${L.key}-arr${e.tone === "teacher" ? "-t" : ""})`}
            />
          ))}

          {L.nodes.map((n) => {
            const rows = textRows(n, L);
            return (
              <g class:list={["pt-node", n.fam, n.dashed && "dashed"]}>
                <rect
                  x={n.x}
                  y={n.y}
                  width={n.w}
                  height={n.h}
                  rx={n.fam === "model" ? n.h / 2 : 6}
                  style={n.fam === "split" ? `stroke: url(#pt-${L.key}-split)` : undefined}
                />
                <text class="pt-title" x={n.x + n.w / 2} y={rows.title}>
                  {n.title}
                </text>
                {(n.sub ?? []).map((line, i) => (
                  <text class="pt-sub" x={n.x + n.w / 2} y={rows.subs[i]}>
                    {line}
                  </text>
                ))}
              </g>
            );
          })}

          {L.labels.map((l) => (
            <text
              class:list={["pt-head", l.tone]}
              x={l.x}
              y={l.y}
              text-anchor={l.anchor ?? "start"}
              transform={l.rotate ? `rotate(-90 ${l.x} ${l.y})` : undefined}
            >
              {l.text}
            </text>
          ))}
        </svg>
      ))
    }

    <ul class="pt-key" aria-hidden="true">
      <li><span class="sw sft"></span>SFT · demonstrations</li>
      <li><span class="sw rl"></span>RL · scalar rewards</li>
      <li><span class="sw distill"></span>Distillation · teacher distributions</li>
      <li><span class="sw split"></span>SFT or RL, per teacher</li>
      <li><span class="sw pre"></span>Pretraining</li>
    </ul>
  </div>
  {
    caption && (
      <figcaption class="caption">
        {numbered && figureNumber && <strong>Figure {figureNumber}: </strong>}
        {caption}
      </figcaption>
    )
  }
</figure>

<script>
  // While the wide drawing is on screen it runs under the desktop table of
  // contents; fade the ToC out, as ScrollyMap does for the map.
  const figures = document.querySelectorAll<HTMLElement>(".pt-figure");
  if (figures.length && "IntersectionObserver" in window) {
    const visible = new Set<Element>();
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          const wide = e.target.querySelector(".pt-wide");
          const shown = wide && getComputedStyle(wide).display !== "none";
          if (e.isIntersecting && shown) visible.add(e.target);
          else visible.delete(e.target);
        }
        document.documentElement.classList.toggle("pt-figure-in-view", visible.size > 0);
      },
      { rootMargin: "-10% 0px -10% 0px" },
    );
    figures.forEach((f) => io.observe(f));
  }
</script>

<style is:global>
  html.pt-figure-in-view .desktop-toc {
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
  }

  html.pt-figure-in-view .desktop-toc :is(a, button) {
    visibility: hidden;
  }
</style>

<style>
  /* Theme tokens. Family colours and greys are the explorer's light and
     dark values, so these boxes read as the same parts as the map's. */
  .pt-figure {
    --pt-demo: #2e8b57;
    --pt-reward: #8a55c2;
    --pt-teacher: #2f6fb8;
    --pt-neutral: #7a7f87;
    --pt-surface: var(--bg-1);
    --pt-text: #1c1e22;
    --pt-muted: #5d6168;
    --pt-faint: #878b92;
    --pt-line-strong: #a7abb1;
    --pt-edge: #8f949b;
  }

  :global([data-effective-theme="dark"]) .pt-figure {
    --pt-demo: #6fbf8e;
    --pt-reward: #b48ad8;
    --pt-teacher: #6aa2e0;
    --pt-neutral: #8c919a;
    --pt-text: #eee8d5;
    --pt-muted: #93a1a1;
    --pt-faint: #7d9599;
    --pt-line-strong: #4d7f8b;
    --pt-edge: #6f8f95;
  }

  .pt-figure {
    /* Break out of the 800px text column; the canvas caps the width. */
    grid-column: 1 / -1 !important;
    margin: 1.5rem 0;
    scroll-margin-top: 5rem;
    border-radius: 8px;
  }

  .pt-canvas {
    container-type: inline-size;
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1rem;
    box-sizing: border-box;
  }

  @media (max-width: 720px) {
    .pt-canvas {
      padding: 0;
    }
  }

  .pt-svg {
    display: block;
    width: 100%;
    height: auto;
    margin: 0 auto;
    overflow: visible;
    font-family: var(--font-body);
  }

  .pt-wide {
    display: none;
  }

  /* Below ~940px the wide drawing's labels would shrink under ~10px. */
  @container (min-width: 940px) {
    .pt-wide {
      display: block;
    }
    .pt-narrow {
      display: none;
    }
  }

  /* ---- nodes, after the map's .node boxes */
  .pt-node {
    --c: var(--pt-neutral);
  }
  .pt-node.sft {
    --c: var(--pt-demo);
  }
  .pt-node.rl {
    --c: var(--pt-reward);
  }
  .pt-node.distill {
    --c: var(--pt-teacher);
  }

  .pt-node rect {
    fill: color-mix(in srgb, var(--c) 11%, var(--pt-surface));
    stroke: var(--c);
    stroke-width: 1.5;
  }

  .pt-node.pre rect,
  .pt-node.split rect {
    fill: var(--pt-surface);
  }

  .pt-node.model rect {
    fill: var(--pt-surface);
    stroke: var(--pt-line-strong);
    stroke-width: 1.25;
  }

  .pt-node.dashed rect {
    stroke-dasharray: 5 3;
  }

  .pt-stop-sft {
    stop-color: var(--pt-demo);
  }
  .pt-stop-rl {
    stop-color: var(--pt-reward);
  }

  .pt-title,
  .pt-sub {
    text-anchor: middle;
    dominant-baseline: central;
  }

  .pt-title {
    font-size: var(--pt-t);
    font-weight: 600;
    fill: var(--pt-text);
  }

  .pt-sub {
    font-size: var(--pt-s);
    fill: var(--pt-muted);
  }

  /* ---- edges: the map's thin curves, with small arrowheads */
  .pt-edge {
    fill: none;
    stroke: var(--pt-edge);
    stroke-width: 1.4;
  }
  .pt-edge.dashed {
    stroke-dasharray: 4 4;
  }
  .pt-edge.teacher {
    stroke: color-mix(in srgb, var(--pt-teacher) 75%, transparent);
  }

  .pt-arrowhead {
    fill: var(--pt-edge);
  }
  .pt-arrowhead.teacher {
    fill: var(--pt-teacher);
  }

  .pt-group {
    fill: none;
    stroke: var(--pt-line-strong);
    stroke-width: 1.25;
    stroke-dasharray: 3 5;
  }

  /* Small-caps headings, after the map's .colhead */
  .pt-head {
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    fill: var(--pt-faint);
    dominant-baseline: central;
  }
  .pt-narrow .pt-head {
    font-size: 9.5px;
    letter-spacing: 0.08em;
  }
  .pt-head.teacher {
    fill: var(--pt-teacher);
  }

  /* ---- colour key */
  .pt-key {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.35rem 1.1rem;
    margin: 0.9rem auto 0;
    padding: 0;
    max-width: 52rem;
    font-size: 0.72rem;
    line-height: 1.3;
    color: var(--pt-muted);
  }

  .pt-key li {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin: 0;
  }

  .sw {
    --c: var(--pt-neutral);
    flex: none;
    width: 1.1rem;
    height: 0.7rem;
    border-radius: 3px;
    border: 1.5px solid var(--c);
    background: color-mix(in srgb, var(--c) 11%, var(--pt-surface));
    box-sizing: border-box;
  }
  .sw.sft {
    --c: var(--pt-demo);
  }
  .sw.rl {
    --c: var(--pt-reward);
  }
  .sw.distill {
    --c: var(--pt-teacher);
  }
  .sw.pre {
    background: var(--pt-surface);
  }
  .sw.split {
    border: 0;
    padding: 1.5px;
    background: linear-gradient(
      90deg,
      var(--pt-demo) 50%,
      var(--pt-reward) 50%
    );
    background-clip: border-box;
    position: relative;
  }
  .sw.split::after {
    content: "";
    position: absolute;
    inset: 1.5px;
    border-radius: 2px;
    background: var(--pt-surface);
  }

  /* ---- :target flash and caption, as in Figure.astro */
  @media (prefers-reduced-motion: no-preference) {
    .pt-figure:target {
      animation: pt-figure-target-flash 2s ease-out;
    }

    @keyframes pt-figure-target-flash {
      0% {
        background: color-mix(in srgb, var(--blue) 16%, transparent);
        box-shadow: 0 0 0 0.5rem color-mix(in srgb, var(--blue) 16%, transparent);
      }
      100% {
        background: transparent;
        box-shadow: 0 0 0 0.5rem transparent;
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pt-figure:target {
      outline: 2px solid color-mix(in srgb, var(--blue) 55%, transparent);
      outline-offset: 0.4rem;
    }
  }

  .caption {
    margin-top: 0.75rem;
    font-size: 0.9rem;
    font-style: italic;
    color: var(--sol-1);
    line-height: 1.4;
    max-width: min(90%, 800px);
    margin-left: auto;
    margin-right: auto;
    text-align: center;
  }

  .caption strong {
    font-style: normal;
    color: var(--sol-9);
  }

  :global([data-effective-theme="dark"]) .caption {
    color: var(--sol-0);
  }

  :global([data-effective-theme="dark"]) .caption strong {
    color: var(--sol-10);
  }

  @media (max-width: 720px) {
    .caption {
      font-size: 0.85rem;
      max-width: 90%;
    }
  }
</style>
