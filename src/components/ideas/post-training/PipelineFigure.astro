  ],
  labels: [
    { x: 38, y: 376, text: "Specialist teachers" },
    { x: 38, y: 390, text: "from SFT, the student," },
    { x: 38, y: 404, text: "or each other" },
    { x: 120, y: 672, text: "Per-token scores", tone: "teacher" },
    { x: 6, y: 610, text: "Iteration 2", anchor: "middle", rotate: true },
  ],
