---
/**
 * Bridges the ROC curve and the safety curve: the log-scale ROC curve
 * (styled like RocCurveFigure's) and the safety curve it maps to (styled like
 * SafetyCurveFigure's "all attacks" line), with arrows showing each point
 * lifting from its caught rate to its safety value. Build-time SVG from
 * model.js; theme-aware; no client JS.
 *
 * Name ends in "Figure" so remarkCrossRefs counts it in the figure sequence.
 */
import SvgFigure from "../../SvgFigure.astro";
import { ALL_ATTACKS, logSpace, safetyFromTpr, thresholdFor, tprAt } from "./model.js";
import { C, fmtBudget, linePath, pct, r } from "./figureKit.js";

interface Props {
  id?: string;
  caption?: string;
  numbered?: boolean;
  sideTaskSuccess?: number;
}

const {
  id,
  numbered = true,
  sideTaskSuccess: p = 0.7,
  caption = "The log-scale ROC curve from Figure 2 (solid) and the safety curve it becomes (dashed), for the toy model with side-task success p = 70%. The conversion never reorders points, so the safety curve rises wherever the ROC curve does, only higher. With p = 1 the two curves coincide.",
} = Astro.props;

const W = 800;
const H = 410;
const PAD = { l: 64, r: 24, t: 82, b: 62 };
const innerW = W - PAD.l - PAD.r;
const innerH = H - PAD.t - PAD.b;
const base = PAD.t + innerH;
const sx = (b: number) => r(PAD.l + ((Math.log10(b) + 4) / 4) * innerW);
const sy = (v: number) => r(base - v * innerH);

const tpr = (b: number) => tprAt(ALL_ATTACKS, thresholdFor(b, 1));
const safety = (b: number) => safetyFromTpr(tpr(b), p);

const budgets = logSpace(-4, 0, 160);
const rocPts = budgets.map((b) => [sx(b), sy(tpr(b))]);
const safetyPts = budgets.map((b) => [sx(b), sy(safety(b))]);

const lifts = [0.001, 0.01, 0.1].map((b) => ({ b, t: tpr(b), s: safety(b) }));
const yTicks = [0, 0.25, 0.5, 0.75, 1];
const xTicks = [-4, -3, -2, -1, 0].map((e) => 10 ** e);

const alt = `Two curves against audit budget on a log axis: the toy monitor's ROC curve (caught rate) and its safety curve with side-task success ${pct(p)}. The safety curve has the same shape but sits higher; arrows show ${lifts.map((l) => `${pct(l.t)} becoming ${pct(l.s)} at ${fmtBudget(l.b)}`).join(", ")}.`;
---

<SvgFigure id={id} alt={alt} caption={caption} numbered={numbered} maxWidth={800}>
  <svg viewBox={`0 0 ${W} ${H}`} width="100%" aria-hidden="true" class="as-figure">
    <text x="24" y="28" fill={C.text} font-size="20" font-weight="650">The safety curve is the ROC curve, converted to safety</text>
    <text x="24" y="52" fill={C.muted} font-size="15">
      Same x-axis. Each caught rate lifts to TPR / (TPR + (1 − TPR)·p), with p = {pct(p)}.
    </text>

    {yTicks.map((v) => (
      <>
        <line x1={PAD.l} x2={W - PAD.r} y1={sy(v)} y2={sy(v)} stroke={v === 0 ? C.rule : C.grid} stroke-width="1" />
        <text x={PAD.l - 8} y={sy(v) + 5} fill={C.muted} font-size="14" text-anchor="end">{pct(v)}</text>
      </>
    ))}
    {xTicks.map((b, i) => (
      <text x={sx(b)} y={base + 22} fill={C.muted} font-size="14"
        text-anchor={i === 0 ? "start" : i === xTicks.length - 1 ? "end" : "middle"}>{fmtBudget(b)}</text>
    ))}
    <text x={PAD.l + innerW / 2} y={H - 8} fill={C.muted} font-size="15" text-anchor="middle">
      Audit budget = false-positive rate (log scale)
    </text>
    <text transform={`translate(18 ${PAD.t + innerH / 2}) rotate(-90)`} fill={C.muted} font-size="15" text-anchor="middle">Caught rate or safety</text>

    <path d={linePath(rocPts)} fill="none" stroke={C.text} stroke-width="2.4" />
    <path d={linePath(safetyPts)} fill="none" stroke={C.dim} stroke-width="2.4" stroke-dasharray="7 5" />

    {lifts.map((l) => {
      const x = sx(l.b);
      const y0 = sy(l.t);
      const y1 = sy(l.s);
      return (
        <>
          <line x1={x} x2={x} y1={r(y0 - 6)} y2={r(y1 + 7)} stroke={C.text} stroke-width="1.6" />
          <path d={`M${x} ${r(y1 + 1)} L${r(x - 4.5)} ${r(y1 + 8)} L${r(x + 4.5)} ${r(y1 + 8)} Z`} fill={C.text} />
          <circle cx={x} cy={y0} r="4.5" fill={C.text} />
          <text x={r(x + 10)} y={r(y0 + 22)} fill={C.text} font-size="14">{pct(l.t)} → {pct(l.s)}</text>
        </>
      );
    })}

    <text x={r(sx(0.03) + 10)} y={r(sy(tpr(0.03)) + 30)} fill={C.text} font-size="16">ROC curve: caught rate</text>
    <text x={sx(4e-4)} y={sy(safety(4e-4)) - 14} fill={C.muted} font-size="16" text-anchor="middle">Safety</text>
  </svg>
</SvgFigure>

<style>
  .as-figure {
    display: block;
    font-family: var(--font-body);
  }
</style>
