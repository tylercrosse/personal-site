---
/**
 * Part 1's picture, before any selection: honest and attack score
 * distributions with the audit threshold τ at a 1% budget. Computed at build
 * time from the same toy model as the widgets (model.js), drawn as inline SVG
 * in theme colors so it reads in light and dark mode. No client JS.
 *
 * Name ends in "Figure" so remarkCrossRefs counts it in the figure sequence.
 */
import SvgFigure from "../../SvgFigure.astro";
import { ALL_ATTACKS, GRID, honestMass, thresholdFor, tprAt } from "./model.js";

interface Props {
  id?: string;
  caption?: string;
  numbered?: boolean;
  budget?: number;
}

const {
  id,
  numbered = true,
  budget = 0.01,
  caption = "Toy model: honest scores ~ Normal(0, 1), attack scores ~ Normal(2.3, 1.1). The audit threshold τ sits where the top 1% of honest scores begin; every attack above it gets caught.",
} = Astro.props;

const SIGMA = 1;
const X_MIN = -4;
const X_MAX = 7;
const W = 800;
const H = 370;
const PAD = { l: 24, r: 24, t: 78, b: 56 };
const innerW = W - PAD.l - PAD.r;
const innerH = H - PAD.t - PAD.b;
const base = PAD.t + innerH;

const r = (v: number) => Math.round(v * 100) / 100;
const pct = (v: number) => `${Math.round(v * 100)}%`;

const tau = thresholdFor(budget, SIGMA);
const caught = tprAt(ALL_ATTACKS, tau);

const idx = GRID.map((x, i) => [x, i] as const).filter(([x]) => x <= X_MAX);
const honest = honestMass(SIGMA);
const peak = Math.max(...idx.map(([, i]) => Math.max(honest[i], ALL_ATTACKS[i])));
const sx = (x: number) => r(PAD.l + ((x - X_MIN) / (X_MAX - X_MIN)) * innerW);
const sy = (v: number) => r(base - (v / peak) * (innerH - 24));

const line = (mass: number[]) =>
  idx.map(([x, i], k) => `${k ? "L" : "M"}${sx(x)} ${sy(mass[i])}`).join(" ");
const tail = (mass: number[]) => {
  const pts = idx.filter(([x]) => x >= tau);
  return `M${sx(tau)} ${base} ${pts.map(([x, i]) => `L${sx(x)} ${sy(mass[i])}`).join(" ")} L${sx(X_MAX)} ${base} Z`;
};

const tauX = sx(tau);
const ticks = [-4, -2, 0, 2, 4, 6];

// Theme colors (see chartKit.jsx INK): --gray-dark is an "r, g, b" triplet.
const TEXT = "rgb(var(--gray-dark))";
const MUTED = "var(--sol-8)";
const DIM = "var(--sol-7)";
const RULE = "color-mix(in srgb, rgb(var(--gray-dark)) 24%, rgb(var(--gray-light)))";

const alt = `Two overlapping score distributions: honest trajectories centered at 0 and attacks centered at 2.3. A dashed threshold at τ = ${tau.toFixed(2)} marks the top ${pct(budget)} of honest scores; ${pct(caught)} of attacks sit above it and are caught.`;
---

<SvgFigure id={id} alt={alt} caption={caption} numbered={numbered} maxWidth={800}>
  <svg viewBox={`0 0 ${W} ${H}`} width="100%" aria-hidden="true" class="threshold-figure">
    <text x={PAD.l} y="28" fill={TEXT} font-size="20" font-weight="650">
      A {pct(budget)} audit budget catches {pct(caught)} of attacks
    </text>
    <text x={PAD.l} y="52" fill={MUTED} font-size="15">
      Toy model. Each curve is scaled to the same area. Shaded regions sit above τ and get audited.
    </text>

    <path d={tail(ALL_ATTACKS)} fill={DIM} fill-opacity="0.22" />
    <path d={tail(honest)} fill={MUTED} fill-opacity="0.28" />
    <path d={line(honest)} fill="none" stroke={MUTED} stroke-width="2.4" />
    <path d={line(ALL_ATTACKS)} fill="none" stroke={DIM} stroke-width="2.2" stroke-dasharray="7 5" />

    <line x1={PAD.l} x2={W - PAD.r} y1={base} y2={base} stroke={RULE} stroke-width="1.2" />
    {ticks.map((t) => (
      <text x={sx(t)} y={base + 22} fill={MUTED} font-size="14" text-anchor="middle">{t}</text>
    ))}
    <text x={PAD.l + innerW / 2} y={H - 8} fill={MUTED} font-size="15" text-anchor="middle">
      Trajectory suspicion score (max over steps)
    </text>

    <line x1={tauX} x2={tauX} y1={PAD.t - 6} y2={base} stroke={TEXT} stroke-width="1.5" stroke-dasharray="5 4" />
    <text x={tauX + 8} y={PAD.t + 8} fill={TEXT} font-size="15">τ: top {pct(budget)} of honest scores</text>

    <text x={sx(-1.25)} y={sy(honest[idx.findIndex(([x]) => x >= -1.25)]) - 30} fill={TEXT} font-size="16" text-anchor="end">
      Honest trajectories
    </text>
    <text x={sx(-1.25)} y={sy(honest[idx.findIndex(([x]) => x >= -1.25)]) - 10} fill={MUTED} font-size="15" text-anchor="end">
      {pct(budget)} above τ, audited
    </text>

    <text x={sx(4.35)} y={sy(ALL_ATTACKS[idx.findIndex(([x]) => x >= 3.4)]) - 30} fill={TEXT} font-size="16">
      All attacks
    </text>
    <text x={sx(4.35)} y={sy(ALL_ATTACKS[idx.findIndex(([x]) => x >= 3.4)]) - 10} fill={MUTED} font-size="15">
      {pct(caught)} above τ, caught
    </text>
  </svg>
</SvgFigure>

<style>
  .threshold-figure {
    display: block;
    font-family: var(--font-body);
  }
</style>
