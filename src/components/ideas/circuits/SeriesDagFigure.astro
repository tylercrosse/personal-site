---
/**
 * Compact dependency timeline for the Transformer Circuits notes series:
 * the twelve covered papers in chronological order, snaking across three rows
 * (alternating direction each row) so the labels stay legible at column
 * width. Solid arrows mark "builds directly on"; dashed arrows mark softer
 * links (induction heads -> attention QK, the lead-in from the Distill
 * vision-circuits work, and most of the third row, whose papers share a
 * steering-vector method rather than a dependency). The exception is the
 * solid introspection -> NLA arc, drawn under the third row because it skips
 * the emotions node: NLA's warm start leans on the introspection result, and
 * NLA is the one third-row paper that inherits machinery from the
 * dictionary-learning line above.
 */
import SvgFigure from "../../SvgFigure.astro";

interface Props {
  caption?: string;
  numbered?: boolean;
  /** Cross-reference target; `id="foo"` is reachable as `[fig:foo]`. */
  id?: string;
}

const {
  caption = "What builds on what, 2021–2026. Solid arrows mark direct dependencies; dashed arrows mark looser links. The third row is the turn toward behavior, with natural language autoencoders bridging the two arcs through the autoencoder objective and the introspection result.",
  numbered = false,
  id,
} = Astro.props;
---

<SvgFigure
  id={id}
  alt="Timeline of the twelve papers covered by the series, from the 2021 framework paper to the 2026 global workspace paper, snaking across three rows with arrows showing which papers build directly on which"
  caption={caption}
  numbered={numbered}
  maxWidth={640}
>
  <svg viewBox="0 0 580 515" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <marker id="dag-n" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M 0 0 L 10 5 L 0 10 z" fill="currentColor" fill-opacity="0.6" />
      </marker>
    </defs>

    <!-- dependency arcs, top row -->
    <path d="M 99 50 Q 155 6 211 48" fill="none" stroke="currentColor" stroke-opacity="0.5" stroke-width="1.4" marker-end="url(#dag-n)" />
    <path d="M 71 50 Q 211 -14 351 48" fill="none" stroke="currentColor" stroke-opacity="0.5" stroke-width="1.4" marker-end="url(#dag-n)" />
    <path d="M 379 50 Q 435 6 491 48" fill="none" stroke="currentColor" stroke-opacity="0.5" stroke-width="1.4" marker-end="url(#dag-n)" />

    <!-- wrap from row one to row two -->
    <path d="M 505 118 L 505 218" fill="none" stroke="currentColor" stroke-opacity="0.5" stroke-width="1.4" marker-end="url(#dag-n)" />

    <!-- soft dependency: induction heads -> attention QK -->
    <path d="M 225 118 L 225 218" fill="none" stroke="currentColor" stroke-opacity="0.45" stroke-width="1.4" stroke-dasharray="4 3" marker-end="url(#dag-n)" />

    <!-- dependency arcs, bottom row (right to left) -->
    <path d="M 491 222 Q 435 178 379 220" fill="none" stroke="currentColor" stroke-opacity="0.5" stroke-width="1.4" marker-end="url(#dag-n)" />
    <path d="M 351 222 Q 295 178 239 220" fill="none" stroke="currentColor" stroke-opacity="0.5" stroke-width="1.4" marker-end="url(#dag-n)" />
    <path d="M 211 222 Q 155 178 99 220" fill="none" stroke="currentColor" stroke-opacity="0.5" stroke-width="1.4" marker-end="url(#dag-n)" />

    <!-- lead-in from the Distill lineage -->
    <line x1="6" y1="83" x2="22" y2="83" stroke="currentColor" stroke-opacity="0.45" stroke-width="1.3" stroke-dasharray="4 3" marker-end="url(#dag-n)" />
    <text x="26" y="138" font-size="10.5" fill="currentColor" fill-opacity="0.5">&#8592; from Distill&#8217;s vision-circuits</text>
    <text x="26" y="153" font-size="10.5" fill="currentColor" fill-opacity="0.5">work (2017&#8211;21)</text>

    <!-- paper nodes, top row -->
    <rect x="26" y="52" width="118" height="62" rx="9" style="stroke: var(--blue); fill: var(--blue)" fill-opacity="0.06" stroke-width="1.4" />
    <text x="85" y="80" font-size="13" font-weight="600" text-anchor="middle" fill="currentColor" fill-opacity="0.9">Framework</text>
    <text x="85" y="100" font-size="10.5" text-anchor="middle" fill="currentColor" fill-opacity="0.5">2021</text>

    <rect x="166" y="52" width="118" height="62" rx="9" style="stroke: var(--blue); fill: var(--blue)" fill-opacity="0.06" stroke-width="1.4" />
    <text x="225" y="80" font-size="13" font-weight="600" text-anchor="middle" fill="currentColor" fill-opacity="0.9">Induction heads</text>
    <text x="225" y="100" font-size="10.5" text-anchor="middle" fill="currentColor" fill-opacity="0.5">2022</text>

    <rect x="306" y="52" width="118" height="62" rx="9" style="stroke: var(--blue); fill: var(--blue)" fill-opacity="0.06" stroke-width="1.4" />
    <text x="365" y="80" font-size="13" font-weight="600" text-anchor="middle" fill="currentColor" fill-opacity="0.9">Superposition</text>
    <text x="365" y="100" font-size="10.5" text-anchor="middle" fill="currentColor" fill-opacity="0.5">2022&#8211;23</text>

    <rect x="446" y="52" width="118" height="62" rx="9" style="stroke: var(--blue); fill: var(--blue)" fill-opacity="0.06" stroke-width="1.4" />
    <text x="505" y="80" font-size="13" font-weight="600" text-anchor="middle" fill="currentColor" fill-opacity="0.9">Monosemanticity</text>
    <text x="505" y="100" font-size="10.5" text-anchor="middle" fill="currentColor" fill-opacity="0.5">2023&#8211;24</text>

    <!-- paper nodes, bottom row (right to left) -->
    <rect x="446" y="224" width="118" height="62" rx="9" style="stroke: var(--blue); fill: var(--blue)" fill-opacity="0.06" stroke-width="1.4" />
    <text x="505" y="252" font-size="13" font-weight="600" text-anchor="middle" fill="currentColor" fill-opacity="0.9">Crosscoders</text>
    <text x="505" y="272" font-size="10.5" text-anchor="middle" fill="currentColor" fill-opacity="0.5">2024</text>

    <rect x="306" y="224" width="118" height="62" rx="9" style="stroke: var(--blue); fill: var(--blue)" fill-opacity="0.06" stroke-width="1.4" />
    <text x="365" y="245" font-size="13" font-weight="600" text-anchor="middle" fill="currentColor" fill-opacity="0.9">Attribution</text>
    <text x="365" y="261" font-size="13" font-weight="600" text-anchor="middle" fill="currentColor" fill-opacity="0.9">graphs</text>
    <text x="365" y="278" font-size="10.5" text-anchor="middle" fill="currentColor" fill-opacity="0.5">2025</text>

    <rect x="166" y="224" width="118" height="62" rx="9" style="stroke: var(--blue); fill: var(--blue)" fill-opacity="0.06" stroke-width="1.4" />
    <text x="225" y="252" font-size="13" font-weight="600" text-anchor="middle" fill="currentColor" fill-opacity="0.9">Attention QK</text>
    <text x="225" y="272" font-size="10.5" text-anchor="middle" fill="currentColor" fill-opacity="0.5">2025</text>

    <rect x="26" y="224" width="118" height="62" rx="9" style="stroke: var(--blue); fill: var(--blue)" fill-opacity="0.06" stroke-width="1.4" />
    <text x="85" y="252" font-size="13" font-weight="600" text-anchor="middle" fill="currentColor" fill-opacity="0.9">Manifolds</text>
    <text x="85" y="272" font-size="10.5" text-anchor="middle" fill="currentColor" fill-opacity="0.5">2025</text>

    <!-- soft link: attention QK supplies only a candidate mechanism, not machinery -->
    <path d="M 200 290 Q 130 330 92 390" fill="none" stroke="currentColor" stroke-opacity="0.45" stroke-width="1.4" stroke-dasharray="4 3" marker-end="url(#dag-n)" />

    <!-- third row: the thread turns toward behaviour -->
    <rect x="26" y="396" width="118" height="62" rx="9" style="stroke: var(--blue); fill: var(--blue)" fill-opacity="0.06" stroke-width="1.4" />
    <text x="85" y="424" font-size="13" font-weight="600" text-anchor="middle" fill="currentColor" fill-opacity="0.9">Introspection</text>
    <text x="85" y="444" font-size="10.5" text-anchor="middle" fill="currentColor" fill-opacity="0.5">2025</text>

    <!-- shared method, not a dependency: both rely on steering vectors -->
    <path d="M 124 394 Q 168 360 211 392" fill="none" stroke="currentColor" stroke-opacity="0.45" stroke-width="1.4" stroke-dasharray="4 3" marker-end="url(#dag-n)" />

    <rect x="166" y="396" width="118" height="62" rx="9" style="stroke: var(--blue); fill: var(--blue)" fill-opacity="0.06" stroke-width="1.4" />
    <text x="225" y="424" font-size="13" font-weight="600" text-anchor="middle" fill="currentColor" fill-opacity="0.9">Emotions</text>
    <text x="225" y="444" font-size="10.5" text-anchor="middle" fill="currentColor" fill-opacity="0.5">2026</text>

    <!-- chronological neighbour, not a dependency -->
    <path d="M 239 394 Q 295 360 351 392" fill="none" stroke="currentColor" stroke-opacity="0.45" stroke-width="1.4" stroke-dasharray="4 3" marker-end="url(#dag-n)" />

    <rect x="306" y="396" width="118" height="62" rx="9" style="stroke: var(--blue); fill: var(--blue)" fill-opacity="0.06" stroke-width="1.4" />
    <text x="365" y="417" font-size="13" font-weight="600" text-anchor="middle" fill="currentColor" fill-opacity="0.9">Natural language</text>
    <text x="365" y="433" font-size="13" font-weight="600" text-anchor="middle" fill="currentColor" fill-opacity="0.9">autoencoders</text>
    <text x="365" y="450" font-size="10.5" text-anchor="middle" fill="currentColor" fill-opacity="0.5">2026</text>

    <!-- real dependency, routed under the row because it skips Emotions -->
    <path d="M 92 460 Q 225 504 358 460" fill="none" stroke="currentColor" stroke-opacity="0.5" stroke-width="1.4" marker-end="url(#dag-n)" />

    <!-- chronological neighbour: the J-lens borrows no machinery from NLA -->
    <path d="M 379 394 Q 435 360 491 392" fill="none" stroke="currentColor" stroke-opacity="0.45" stroke-width="1.4" stroke-dasharray="4 3" marker-end="url(#dag-n)" />

    <rect x="446" y="396" width="118" height="62" rx="9" style="stroke: var(--blue); fill: var(--blue)" fill-opacity="0.06" stroke-width="1.4" />
    <text x="505" y="424" font-size="13" font-weight="600" text-anchor="middle" fill="currentColor" fill-opacity="0.9">Workspace</text>
    <text x="505" y="444" font-size="10.5" text-anchor="middle" fill="currentColor" fill-opacity="0.5">2026</text>
  </svg>
</SvgFigure>
