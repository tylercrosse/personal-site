---
/**
 * Compact dependency timeline for the Transformer Circuits notes series:
 * the six covered papers in chronological order, with arcs for "builds
 * directly on" and a dashed lead-in from the Distill vision-circuits work.
 */
import SvgFigure from "../../SvgFigure.astro";

interface Props {
  caption?: string;
  numbered?: boolean;
}

const {
  caption = "What builds on what, 2021–2025. Each arc is a direct dependency: the later paper leans on the earlier one’s result or vocabulary. Chronological order and reading order coincide.",
  numbered = false,
} = Astro.props;
---

<SvgFigure
  alt="Timeline of the six papers covered by the series, from the 2021 framework paper to the 2025 attribution-graphs papers, with arcs showing which papers build directly on which"
  caption={caption}
  numbered={numbered}
  maxWidth={720}
>
  <svg viewBox="0 0 760 196" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <marker id="dag-n" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M 0 0 L 10 5 L 0 10 z" fill="currentColor" fill-opacity="0.6" />
      </marker>
    </defs>

    <!-- dependency arcs -->
    <path d="M 95 108 Q 148 58 197 106" fill="none" stroke="currentColor" stroke-opacity="0.5" stroke-width="1.4" marker-end="url(#dag-n)" />
    <path d="M 67 108 Q 194 22 317 104" fill="none" stroke="currentColor" stroke-opacity="0.5" stroke-width="1.4" marker-end="url(#dag-n)" />
    <path d="M 327 108 Q 381 58 435 106" fill="none" stroke="currentColor" stroke-opacity="0.5" stroke-width="1.4" marker-end="url(#dag-n)" />
    <path d="M 447 108 Q 501 58 555 106" fill="none" stroke="currentColor" stroke-opacity="0.5" stroke-width="1.4" marker-end="url(#dag-n)" />
    <path d="M 567 108 Q 621 58 675 106" fill="none" stroke="currentColor" stroke-opacity="0.5" stroke-width="1.4" marker-end="url(#dag-n)" />

    <!-- lead-in from the Distill lineage -->
    <line x1="2" y1="140" x2="22" y2="140" stroke="currentColor" stroke-opacity="0.45" stroke-width="1.3" stroke-dasharray="4 3" marker-end="url(#dag-n)" />
    <text x="4" y="188" font-size="10" fill="currentColor" fill-opacity="0.5">&#8592; from Distill&#8217;s vision-circuits work (2017&#8211;21)</text>

    <!-- paper nodes -->
    <rect x="28" y="112" width="106" height="56" rx="9" style="stroke: var(--blue); fill: var(--blue)" fill-opacity="0.06" stroke-width="1.4" />
    <text x="81" y="136" font-size="11.5" font-weight="600" text-anchor="middle" fill="currentColor" fill-opacity="0.9">Framework</text>
    <text x="81" y="154" font-size="10" text-anchor="middle" fill="currentColor" fill-opacity="0.5">2021</text>

    <rect x="148" y="112" width="106" height="56" rx="9" style="stroke: var(--blue); fill: var(--blue)" fill-opacity="0.06" stroke-width="1.4" />
    <text x="201" y="136" font-size="11.5" font-weight="600" text-anchor="middle" fill="currentColor" fill-opacity="0.9">Induction heads</text>
    <text x="201" y="154" font-size="10" text-anchor="middle" fill="currentColor" fill-opacity="0.5">2022</text>

    <rect x="268" y="112" width="106" height="56" rx="9" style="stroke: var(--blue); fill: var(--blue)" fill-opacity="0.06" stroke-width="1.4" />
    <text x="321" y="136" font-size="11.5" font-weight="600" text-anchor="middle" fill="currentColor" fill-opacity="0.9">Superposition</text>
    <text x="321" y="154" font-size="10" text-anchor="middle" fill="currentColor" fill-opacity="0.5">2022&#8211;23</text>

    <rect x="388" y="112" width="106" height="56" rx="9" style="stroke: var(--blue); fill: var(--blue)" fill-opacity="0.06" stroke-width="1.4" />
    <text x="441" y="136" font-size="11" font-weight="600" text-anchor="middle" fill="currentColor" fill-opacity="0.9">Monosemanticity</text>
    <text x="441" y="154" font-size="10" text-anchor="middle" fill="currentColor" fill-opacity="0.5">2023&#8211;24</text>

    <rect x="508" y="112" width="106" height="56" rx="9" style="stroke: var(--blue); fill: var(--blue)" fill-opacity="0.06" stroke-width="1.4" />
    <text x="561" y="136" font-size="11.5" font-weight="600" text-anchor="middle" fill="currentColor" fill-opacity="0.9">Crosscoders</text>
    <text x="561" y="154" font-size="10" text-anchor="middle" fill="currentColor" fill-opacity="0.5">2024</text>

    <rect x="628" y="112" width="106" height="56" rx="9" style="stroke: var(--blue); fill: var(--blue)" fill-opacity="0.06" stroke-width="1.4" />
    <text x="681" y="130" font-size="11.5" font-weight="600" text-anchor="middle" fill="currentColor" fill-opacity="0.9">Attribution</text>
    <text x="681" y="144" font-size="11.5" font-weight="600" text-anchor="middle" fill="currentColor" fill-opacity="0.9">graphs</text>
    <text x="681" y="160" font-size="10" text-anchor="middle" fill="currentColor" fill-opacity="0.5">2025</text>
  </svg>
</SvgFigure>
