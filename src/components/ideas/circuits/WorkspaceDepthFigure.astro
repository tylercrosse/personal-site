---
/**
 * Where the J-lens reads. The residual stream drawn vertically so "a third of
 * the way up" is literal, divided into the three bands the paper names, with
 * the lens tapping the stream rather than sitting at the end of it.
 *
 * Orientation only — the evidence for drawing the boundaries here is the
 * layer-similarity comparison much later in the post. Kept narrow, with the
 * prose in the caption, so the labels survive phone widths.
 */
import SvgFigure from "../../SvgFigure.astro";

interface Props {
  caption?: string;
  numbered?: boolean;
  id?: string;
}

const {
  caption = "The lens taps the residual stream partway up rather than reading the end of it, which is what lets it report something other than the next token. Almost every readout in this post is taken from the middle band. The paper cannot say much about the bottom third: the averaged Jacobian relates each layer to the final one, and the early layers are furthest from it, so content there may be absent or merely unreadable this way. The evidence for drawing the boundaries where they sit comes near the end of the post.",
  numbered = true,
  id,
} = Astro.props;
---

<SvgFigure
  id={id}
  caption={caption}
  numbered={numbered}
  maxWidth={600}
  alt="The residual stream drawn as a vertical column from the token embedding at the bottom to the unembedding at the top, divided into three bands: a sensory region filling the bottom third, a long workspace region in the middle, and a short motor stretch at the top. An arrow taps the workspace band and leads to a J-lens readout showing the tokens orange, lemon, and fruit. A faded dashed arrow taps the sensory band and leads to a note that early layers are mostly unreadable this way."
>
  <svg viewBox="0 0 450 322" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <marker id="wd-b" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M 0 0 L 10 5 L 0 10 z" style="fill: var(--blue)" />
      </marker>
      <marker id="wd-n" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M 0 0 L 10 5 L 0 10 z" fill="currentColor" fill-opacity="0.45" />
      </marker>
    </defs>

    <!-- unembedding at the top of the stream -->
    <text x="164" y="14" font-size="11" text-anchor="middle" fill="currentColor" fill-opacity="0.6" font-style="italic">W<tspan dy="3" font-size="8">U</tspan></text>
    <line x1="164" y1="36" x2="164" y2="20" stroke="currentColor" stroke-opacity="0.45" stroke-width="1.4" marker-end="url(#wd-n)" />

    <!-- the stream, bottom to top -->
    <rect x="128" y="42" width="72" height="250" rx="9" fill="currentColor" fill-opacity="0.05" stroke="currentColor" stroke-opacity="0.35" stroke-width="1.2" />
    <text
      x="20"
      y="167"
      font-size="11"
      text-anchor="middle"
      transform="rotate(-90 20 167)"
      fill="currentColor"
      fill-opacity="0.5"
      font-style="italic">residual stream</text>
    <line x1="30" y1="60" x2="30" y2="128" stroke="currentColor" stroke-opacity="0.25" stroke-width="1" />
    <line x1="30" y1="206" x2="30" y2="274" stroke="currentColor" stroke-opacity="0.25" stroke-width="1" />

    <!-- motor band -->
    <path d="M 128 51 a 9 9 0 0 1 9 -9 h 54 a 9 9 0 0 1 9 9 v 29 h -72 z" fill="currentColor" fill-opacity="0.08" />
    <text x="164" y="66" font-size="12.5" text-anchor="middle" fill="currentColor" fill-opacity="0.75">motor</text>

    <!-- workspace band -->
    <rect x="128" y="80" width="72" height="129" fill="var(--blue)" fill-opacity="0.14" />
    <text x="164" y="141" font-size="13" text-anchor="middle" style="fill: var(--blue)">workspace</text>

    <!-- sensory band -->
    <path d="M 128 209 h 72 v 74 a 9 9 0 0 1 -9 9 h -54 a 9 9 0 0 1 -9 -9 z" fill="currentColor" fill-opacity="0.05" />
    <text x="164" y="254" font-size="12.5" text-anchor="middle" fill="currentColor" fill-opacity="0.5">sensory</text>

    <!-- band boundaries -->
    <line x1="128" y1="80" x2="200" y2="80" stroke="currentColor" stroke-opacity="0.35" stroke-width="1.2" stroke-dasharray="3 3" />
    <line x1="128" y1="209" x2="200" y2="209" stroke="currentColor" stroke-opacity="0.55" stroke-width="1.5" />

    <!-- depth annotations, left -->
    <text x="118" y="46" font-size="10.5" text-anchor="end" fill="currentColor" fill-opacity="0.5">final layer</text>
    <text x="118" y="206" font-size="10.5" text-anchor="end" fill="currentColor" fill-opacity="0.6">about a third up</text>
    <text x="118" y="296" font-size="10.5" text-anchor="end" fill="currentColor" fill-opacity="0.5">layer 0</text>

    <!-- tokens in -->
    <line x1="164" y1="312" x2="164" y2="296" stroke="currentColor" stroke-opacity="0.45" stroke-width="1.4" marker-end="url(#wd-n)" />
    <text x="164" y="322" font-size="10.5" text-anchor="middle" fill="currentColor" fill-opacity="0.5">tokens</text>

    <!-- the lens taps the middle band -->
    <line x1="200" y1="140" x2="234" y2="140" stroke="var(--blue)" stroke-opacity="0.85" stroke-width="1.6" marker-end="url(#wd-b)" />
    <rect x="242" y="104" width="200" height="74" rx="8" fill="var(--blue)" fill-opacity="0.08" stroke="var(--blue)" stroke-opacity="0.7" stroke-width="1.4" />
    <text x="254" y="122" font-size="11" style="fill: var(--blue)">J-lens readout</text>
    <text x="254" y="142" font-size="12.5" fill="currentColor" font-family="var(--font-mono)">orange</text>
    <text x="254" y="160" font-size="12.5" fill="currentColor" fill-opacity="0.75" font-family="var(--font-mono)">lemon</text>
    <text x="330" y="142" font-size="12.5" fill="currentColor" fill-opacity="0.75" font-family="var(--font-mono)">fruit</text>
    <text x="330" y="160" font-size="12.5" fill="currentColor" fill-opacity="0.55" font-family="var(--font-mono)">thinking</text>

    <!-- and can say little about the bottom third -->
    <line x1="200" y1="250" x2="234" y2="250" stroke="currentColor" stroke-opacity="0.35" stroke-width="1.4" stroke-dasharray="4 3.5" marker-end="url(#wd-n)" />
    <rect x="242" y="230" width="200" height="40" rx="8" fill="none" stroke="currentColor" stroke-opacity="0.28" stroke-width="1.2" stroke-dasharray="4 3.5" />
    <text x="254" y="247" font-size="10.5" fill="currentColor" fill-opacity="0.5">absent, or unreadable</text>
    <text x="254" y="261" font-size="10.5" fill="currentColor" fill-opacity="0.5">this way? The paper cannot tell.</text>
  </svg>
</SvgFigure>
