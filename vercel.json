{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/sitemap.xml",
      "destination": "https://www.tylercrosse.com/sitemap-index.xml",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "tylercrosse.com"
        }
      ],
      "destination": "https://www.tylercrosse.com/$1",
      "permanent": true
    }
  ]
}
