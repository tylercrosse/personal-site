{
  "name": "personal-site",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/audit-references.mjs && node scripts/audit-metadata.mjs && node scripts/check-refs.mjs && astro build && node scripts/check-internal-links.mjs",
    "preview": "astro preview",
    "check:links": "node scripts/check-internal-links.mjs",
    "check:refs": "node scripts/check-refs.mjs",
    "check:references": "node scripts/audit-references.mjs",
    "check:metadata": "node scripts/audit-metadata.mjs",
    "social:generate": "node scripts/generate-social-cards.mjs",
    "astro": "astro",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "playwright:install": "playwright install chromium"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.4",
    "@astrojs/mdx": "^8.1.1",
    "@astrojs/react": "^7.1.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@pagefind/default-ui": "^1.5.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "astro": "^7.4.2",
    "astro-pagefind": "^2.0.1",
    "katex": "^0.16.47",
    "lucide-astro": "^0.556.0",
    "pagefind": "^1.5.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "reading-time": "^1.5.0",
    "rehype-callouts": "^2.2.0",
    "rehype-citation": "^2.3.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sharp": "^0.35.5"
  },
  "optionalDependencies": {
    "@rollup/rollup-darwin-arm64": "4.62.2",
    "@rollup/rollup-linux-x64-gnu": "4.62.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "gray-matter": "^4.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@vercel/speed-insights",
      "esbuild",
      "sharp"
    ],
    "overrides": {
      "mermaid": "11.12.0"
    },
    "supportedArchitectures": {
      "os": [
        "current",
        "linux"
      ],
      "cpu": [
        "current",
        "x64"
      ],
      "libc": [
        "current",
        "glibc"
      ]
    }
  }
}
